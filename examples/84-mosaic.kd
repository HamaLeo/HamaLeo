// 🟦 مۆزایک — تایلی ڕەنگاوڕەنگ کە هێواش ڕەنگ دەگۆڕن. کلیک بکە بۆ شەپۆلێک
قەبارە(٤٥٠، ٣٢٠)
نەگۆڕ تایلەکان = []
بۆ ڕ لە ٠ تا ١٥ { بۆ س لە ٠ تا ٢٢ { تایلەکان.زیادبکە({ ڕەنگ: هەڕەمەکی(٠، ٣٦٠)، ئامانج: هەڕەمەکی(٠، ٣٦٠) }) } }
گۆڕاو کات = ٠
گۆڕاو شەپۆل = -١
یاریبکە(() => {
  کات += ١
  ئەگەر کلیککراوە() { شەپۆل = ٠ }
  ئەگەر شەپۆل >= ٠ { شەپۆل += ٠٫٣٥؛ ئەگەر شەپۆل > ٣٠ { شەپۆل = -١ } }
  ئەگەر کات % ٤٠ == ٠ { بۆ هەر ت لە تایلەکان { ئەگەر هەڕەمەکی(١، ٤) == ١ { ت.ئامانج = هەڕەمەکی(٠، ٣٦٠) } } }
  پاشبنەمابکە("ڕەش")
  بۆ ڕ لە ٠ تا ١٥ {
    بۆ س لە ٠ تا ٢٢ {
      نەگۆڕ ت = تایلەکان[ڕ * ٢٣ + س]
      نەگۆڕ ج = ((ت.ئامانج - ت.ڕەنگ + ٥٤٠) % ٣٦٠) - ١٨٠
      ت.ڕەنگ += ج * ٠٫٠٤
      گۆڕاو گەشی = ٠٫٤٥
      ئەگەر شەپۆل >= ٠ { گەشی += گەورەترین(٠، ٠٫٤ - ڕەها(دووری(س، ڕ، ١١، ٨) - شەپۆل) * ٠٫١) }
      ڕەنگبکە(پەلکەزێڕینە(ت.ڕەنگ، بچووکترین(گەشی، ١)))
      لاکێش(س * ١٩٫٦ + ١، ڕ * ٢٠ + ١، ١٧٫٦، ١٨)
    }
  }
})
