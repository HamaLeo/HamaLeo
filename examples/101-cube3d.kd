// 🧊 مکعبی سێ ڕەهەندی — کۆدکەر بیرکاری ٣D دەکات: ٨ گۆشە دەسووڕێنێت و بە «پێرسپێکتیڤ» (x / z) دەیانکێشێت. ماوس = خێراییەکەی
قەبارە(٣٦٠، ٣٦٠)
نەگۆڕ گۆشەکان = [[-١، -١، -١]، [١، -١، -١]، [١، ١، -١]، [-١، ١، -١]، [-١، -١، ١]، [١، -١، ١]، [١، ١، ١]، [-١، ١، ١]]
نەگۆڕ لێوارەکان = [[٠، ١]، [١، ٢]، [٢، ٣]، [٣، ٠]، [٤، ٥]، [٥، ٦]، [٦، ٧]، [٧، ٤]، [٠، ٤]، [١، ٥]، [٢، ٦]، [٣، ٧]]
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ماوسX() >= ٠ ? ماوسX() / ٥٠٠٠ + ٠٫٠٠٥ : ٠٫٠٢
  پاشبنەمابکە(ڕەنگی(١٠، ١٥، ٣٥))
  نەگۆڕ نوختەکان = گۆشەکان.نەخشە(گ => {
    // سووڕانەوە بە دەوری Y پاشان X
    نەگۆڕ x١ = گ[٠] * کۆسینۆس(کات) + گ[٢] * سینۆس(کات)
    نەگۆڕ z١ = -گ[٠] * سینۆس(کات) + گ[٢] * کۆسینۆس(کات)
    نەگۆڕ y٢ = گ[١] * کۆسینۆس(کات * ٠٫٧) - z١ * سینۆس(کات * ٠٫٧)
    نەگۆڕ z٢ = گ[١] * سینۆس(کات * ٠٫٧) + z١ * کۆسینۆس(کات * ٠٫٧)
    نەگۆڕ پێرسپێکتیڤ = ٣٠٠ / (٤ + z٢)
    گەڕێنەوە { x: ١٨٠ + x١ * پێرسپێکتیڤ * ٠٫٦٥، y: ١٨٠ + y٢ * پێرسپێکتیڤ * ٠٫٦٥، z: z٢ }
  })
  ئەستووریبکە(٣)
  بۆ هەر ل لە لێوارەکان {
    نەگۆڕ a = نوختەکان[ل[٠]]
    نەگۆڕ b = نوختەکان[ل[١]]
    هێڵڕەنگبکە(پەلکەزێڕینە((a.z + b.z) * ٦٠ + کات * ٥٠))
    هێڵ(a.x، a.y، b.x، b.y)
  }
  بۆ هەر ن لە نوختەکان {
    ڕەنگبکە("سپی")
    بازنە(ن.x، ن.y، ٤ - ن.z)
  }
})
