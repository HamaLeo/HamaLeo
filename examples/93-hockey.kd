// یاری: هۆکی ئاسمانی 🏒 — ماوس پاددەکەتە (بەشی خوارەوە). تۆپ بخەرە ناو دەرگای سەرەوەی دوژمن! یەکەم بە ٧ خاڵ دەبات
قەبارە(٣٠٠، ٤٥٠)
گۆڕاو پک = { x: ١٥٠، y: ٢٢٥، vx: ٣، vy: ٤ }
گۆڕاو پاد = { x: ١٥٠، y: ٣٨٠، vx: ٠، vy: ٠ }
گۆڕاو دژ = { x: ١٥٠، y: ٧٠، vx: ٠، vy: ٠ }
گۆڕاو خاڵی_تۆ = ٠
گۆڕاو خاڵی_دژ = ٠

کار دووبارە_پک(ئا) { پک = { x: ١٥٠، y: ٢٢٥، vx: هەڕەمەکی(-٣، ٣)، vy: ئا * ٣ } }

کار پێکدادان(پ) {
  نەگۆڕ d = دووری(پک.x، پک.y، پ.x، پ.y)
  ئەگەر d < ٣٥ و d > ٠ {
    نەگۆڕ nx = (پک.x - پ.x) / d
    نەگۆڕ ny = (پک.y - پ.y) / d
    نەگۆڕ خێرایی = بچووکترین(١٣، گەورەترین(٥، دووری(٠، ٠، پک.vx، پک.vy) * ٠٫٧ + دووری(٠، ٠، پ.vx، پ.vy) * ٠٫٨))
    پک.vx = nx * خێرایی؛ پک.vy = ny * خێرایی
    پک.x = پ.x + nx * ٣٦؛ پک.y = پ.y + ny * ٣٦
  }
}

یاریبکە(() => {
  ئەگەر خاڵی_تۆ < ٧ و خاڵی_دژ < ٧ {
    ئەگەر ماوسX() >= ٠ {
      نەگۆڕ نx = سنوور(ماوسX()، ٢٥، ٢٧٥)
      نەگۆڕ نy = سنوور(ماوسY()، ٢٥٥، ٤٢٠)
      پاد.vx = نx - پاد.x؛ پاد.vy = نy - پاد.y
      پاد.x = نx؛ پاد.y = نy
    }
    // کۆمپیوتەر: خێرایی سنووردار
    نەگۆڕ ئامانجx = پک.y < ٢٢٥ ? پک.x : ١٥٠
    نەگۆڕ ئامانجy = پک.y < ٢٢٥ ? سنوور(پک.y - ٣٠، ٢٥، ١٨٠) : ٧٠
    دژ.vx = سنوور(ئامانجx - دژ.x، -٤٫٥، ٤٫٥)؛ دژ.vy = سنوور(ئامانجy - دژ.y، -٣، ٣)
    دژ.x += دژ.vx؛ دژ.y += دژ.vy
    دژ.x = سنوور(دژ.x، ٢٥، ٢٧٥)

    پک.x += پک.vx؛ پک.y += پک.vy
    پک.vx *= ٠٫٩٩٥؛ پک.vy *= ٠٫٩٩٥
    ئەگەر پک.x < ١٢ یان پک.x > ٢٨٨ { پک.vx = -پک.vx؛ پک.x = سنوور(پک.x، ١٢، ٢٨٨) }
    ئەگەر پک.y < ١٢ و (پک.x < ١٠٠ یان پک.x > ٢٠٠) { پک.vy = -پک.vy؛ پک.y = ١٢ }
    ئەگەر پک.y > ٤٣٨ و (پک.x < ١٠٠ یان پک.x > ٢٠٠) { پک.vy = -پک.vy؛ پک.y = ٤٣٨ }
    پێکدادان(پاد)؛ پێکدادان(دژ)
    ئەگەر پک.y < -١٠ { خاڵی_تۆ += ١؛ دووبارە_پک(١) }
    ئەگەر پک.y > ٤٦٠ { خاڵی_دژ += ١؛ دووبارە_پک(-١) }
  } ئەگەرنا ئەگەر کلیککراوە() { خاڵی_تۆ = ٠؛ خاڵی_دژ = ٠؛ دووبارە_پک(١) }

  پاشبنەمابکە(ڕەنگی(١٥، ٣٠، ٥٥))
  ڕەنگبکە(ڕەنگی(٣٠، ٥٥، ٩٠))
  لاکێش(٠، ٢٢٢، ٣٠٠، ٦)
  هێڵڕەنگبکە(ڕەنگی(٣٠، ٥٥، ٩٠))
  ئەستووریبکە(٤)
  بازنەهێڵ(١٥٠، ٢٢٥، ٤٠)
  ڕەنگبکە(ڕەنگی(٢٠٠، ٦٠، ٦٠))
  لاکێش(١٠٠، ٠، ١٠٠، ٥)؛ لاکێش(١٠٠، ٤٤٥، ١٠٠، ٥)
  ڕەنگبکە("ئاسمانی")
  بازنە(پاد.x، پاد.y، ٢٥)
  ڕەنگبکە(ڕەنگی(١٥، ٣٠، ٥٥))
  بازنە(پاد.x، پاد.y، ١٢)
  ڕەنگبکە("نارنجی")
  بازنە(دژ.x، دژ.y، ٢٥)
  ڕەنگبکە(ڕەنگی(١٥، ٣٠، ٥٥))
  بازنە(دژ.x، دژ.y، ١٢)
  ڕەنگبکە("سپی")
  بازنە(پک.x، پک.y، ١٠)
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٥))
  نووسین(خاڵی_دژ، ١٠، ٢١٠، ٢٦)
  نووسین(خاڵی_تۆ، ١٠، ٢٥٤، ٢٦)
  ئەگەر خاڵی_تۆ >= ٧ یان خاڵی_دژ >= ٧ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٣٠٠، ٤٥٠)
    ڕەنگبکە("سپی")
    نووسین(خاڵی_تۆ >= ٧ ? "بردتەوە! 🎉" : "کۆمپیوتەر بردیەوە", ٨٠، ٢٠٠، ٢٨)
    نووسین("کلیک = دووبارە", ٩٥، ٢٤٠، ٢٠)
  }
})
