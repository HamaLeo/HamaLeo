// یاری: پازڵی خشتە خلیسکەکان 🔢 — کلیک لە خشتەیەک بکە کە لە تەنیشت شوێنی بەتاڵەوەیە، بیخلیسکێنە. خشتەکان ڕیز بکە: ١ تا ٨
قەبارە(٣٠٠، ٣٨٠)
گۆڕاو خشتەکان = []     // ٩ خانە: ٠ = بەتاڵ
گۆڕاو جووڵە = ٠
گۆڕاو بردرا = هەڵە

کار بەتاڵ_لە() { گەڕێنەوە خشتەکان.شوێن(٠) }

کار بخلیسکێنە(i) {
  نەگۆڕ b = بەتاڵ_لە()
  نەگۆڕ نزیکە = (ڕەها(i % ٣ - b % ٣) + ڕەها(خوارکە(i / ٣) - خوارکە(b / ٣))) == ١
  ئەگەر نزیکە { خشتەکان[b] = خشتەکان[i]؛ خشتەکان[i] = ٠؛ گەڕێنەوە ڕاست }
  گەڕێنەوە هەڵە
}

کار تێکەڵ() {
  خشتەکان = [١، ٢، ٣، ٤، ٥، ٦، ٧، ٨، ٠]
  بۆ k لە ١ تا ١٢٠ {
    نەگۆڕ b = بەتاڵ_لە()
    نەگۆڕ دراوسێکان = []
    بۆ i لە ٠ تا ٨ { ئەگەر (ڕەها(i % ٣ - b % ٣) + ڕەها(خوارکە(i / ٣) - خوارکە(b / ٣))) == ١ { دراوسێکان.زیادبکە(i) } }
    بخلیسکێنە(دراوسێکان[هەڕەمەکی(٠، دراوسێکان.درێژی - ١)])
  }
  جووڵە = ٠؛ بردرا = هەڵە
}
تێکەڵ()

یاریبکە(() => {
  ئەگەر کلیککراوە() {
    ئەگەر بردرا { تێکەڵ() } ئەگەرنا ئەگەر ماوسY() >= ٨٠ {
      نەگۆڕ i = خوارکە((ماوسY() - ٨٠) / ٩٠) * ٣ + خوارکە(ماوسX() / ١٠٠)
      ئەگەر i >= ٠ و i < ٩ و بخلیسکێنە(i) {
        جووڵە += ١
        بردرا = خشتەکان.پاڵاوتن((v، k) => v == k + ١).درێژی == ٨
      }
    }
  }
  پاشبنەمابکە(ڕەنگی(٢٠، ٢٥، ٤٥))
  بۆ i لە ٠ تا ٨ {
    نەگۆڕ v = خشتەکان[i]
    ئەگەر v != ٠ {
      نەگۆڕ x = (i % ٣) * ١٠٠ + ٦
      نەگۆڕ y = خوارکە(i / ٣) * ٩٠ + ٨٦
      ڕەنگبکە(پەلکەزێڕینە(v * ٤٠))
      لاکێش(x، y، ٨٨، ٧٨)
      ڕەنگبکە("سپی")
      نووسین(v، x + ٣٠، y + ٥٣، ٤٠)
    }
  }
  ڕەنگبکە("سپی")
  نووسین("جووڵە: " + جووڵە، ١٥، ٤٥، ٢٤)
  ئەگەر بردرا { ڕەنگبکە("زەرد")؛ نووسین("🎉 تەواو! کلیک = دووبارە", ٤٠، ٣٦٠، ٢٢) }
})
