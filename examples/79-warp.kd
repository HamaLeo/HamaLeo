// 🚀 باز بۆ ئەستێرەکان — بە خێرایی نوور بەناو ئەستێرەکاندا دەفڕیت. ماوس بجووڵێنە بۆ گۆڕینی ئاڕاستە، کلیک = خێراتر
قەبارە(٤٥٠، ٣٢٠)
نەگۆڕ ئەستێرەکان = []
بۆ i لە ١ تا ٢٠٠ { ئەستێرەکان.زیادبکە({ x: هەڕەمەکی(-٥٠٠، ٥٠٠)، y: هەڕەمەکی(-٣٠٠، ٣٠٠)، z: هەڕەمەکی(١، ٥٠٠) }) }
گۆڕاو خێرایی = ٥
یاریبکە(() => {
  ئەگەر ماوسگیراوە() { خێرایی = بچووکترین(٢٥، خێرایی + ٠٫٥) } ئەگەرنا { خێرایی = گەورەترین(٥، خێرایی - ٠٫٣) }
  نەگۆڕ ناوەندx = ماوسX() >= ٠ ? ماوسX() : ٢٢٥
  نەگۆڕ ناوەندy = ماوسY() >= ٠ ? ماوسY() : ١٦٠
  پاشبنەمابکە(ڕەنگی(٣، ٣، ١٠))
  بۆ هەر ئ لە ئەستێرەکان {
    گۆڕاو پێشووz = ئ.z
    ئ.z -= خێرایی
    ئەگەر ئ.z < ١ { ئ.x = هەڕەمەکی(-٥٠٠، ٥٠٠)؛ ئ.y = هەڕەمەکی(-٣٠٠، ٣٠٠)؛ ئ.z = ٥٠٠؛ پێشووz = ٥٠٠ }
    نەگۆڕ sx = ناوەندx + ئ.x / ئ.z * ٢٠٠
    نەگۆڕ sy = ناوەندy + ئ.y / ئ.z * ٢٠٠
    نەگۆڕ px = ناوەندx + ئ.x / پێشووz * ٢٠٠
    نەگۆڕ py = ناوەندy + ئ.y / پێشووz * ٢٠٠
    نەگۆڕ گەشی = ١ - ئ.z / ٥٠٠
    هێڵڕەنگبکە(ڕەنگی(١٨٠ + ٧٠ * گەشی، ٢٠٠ + ٥٥ * گەشی، ٢٥٥، گەشی))
    ئەستووریبکە(١ + گەشی * ٢)
    هێڵ(px، py، sx، sy)
  }
})
