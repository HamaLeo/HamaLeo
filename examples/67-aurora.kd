// 🌌 ڕووناکی باکوور — ڕەنگەکانی ئاسمانی باکوور لە سەر دەریاچەیەکی ئارام
قەبارە(٤٥٠، ٣٢٠)
نەگۆڕ ئەستێرەکان = []
بۆ i لە ١ تا ١٠٠ { ئەستێرەکان.زیادبکە({ x: هەڕەمەکی(٠، ٤٥٠)، y: هەڕەمەکی(٠، ٢٠٠)، ف: هەڕەمەکی(٠، ٣٠٠) }) }
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠١٥
  پاشبنەمابکە(ڕەنگی(٥، ٨، ٢٠))
  بۆ هەر ئ لە ئەستێرەکان {
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٣ + ٠٫٣ * سینۆس(کات * ٥٠ + ئ.ف)))
    بازنە(ئ.x، ئ.y، ١٫٢)
  }
  بۆ هەر ت لە [٠، ١، ٢] {
    بۆ x لە ٠ تا ٨٩ {
      نەگۆڕ بەرزی = ٧٠ + ٤٠ * سینۆس(x * ٠٫٠٨ + کات * (٢ + ت) + ت * ٢) + ٢٥ * سینۆس(x * ٠٫٢ + کات * ٣)
      نەگۆڕ سەرەوە = ٤٠ + ت * ٢٥ + ٣٠ * سینۆس(x * ٠٫٠٥ + کات + ت)
      بۆ k لە ٠ تا ٤ {
        ڕەنگبکە(ڕەنگی(٤٠ + ت * ٥٠ + k * ١٠، ٢٢٠ - ت * ٤٠ - k * ١٥، ١٢٠ + ت * ٦٠، ٠٫٢ - k * ٠٫٠٣))
        لاکێش(x * ٥، سەرەوە + k * بەرزی / ٥، ٥٫٥، بەرزی / ٥)
      }
    }
  }
  ڕەنگبکە(ڕەنگی(٨، ١٥، ٣٠))
  لاکێش(٠، ٢٣٠، ٤٥٠، ٩٠)
  ڕەنگبکە(ڕەنگی(١٠، ٢٠، ٤٠))
  سێگۆشە(٠، ٢٣٠، ٨٠، ١٨٠، ١٦٠، ٢٣٠)
  سێگۆشە(١٢٠، ٢٣٠، ٢٥٠، ١٦٠، ٣٨٠، ٢٣٠)
  سێگۆشە(٣٢٠، ٢٣٠، ٤٠٠، ١٩٠، ٤٥٠، ٢٣٠)
  بۆ x لە ٠ تا ٨٩ {
    ڕەنگبکە(ڕەنگی(٤٠، ٢٠٠، ١٦٠، ٠٫٠٨ + ٠٫٠٥ * سینۆس(x * ٠٫٣ + کات * ٣)))
    لاکێش(x * ٥، ٢٣٠ + (x % ٣) * ٨، ٥٫٥، ٩٠)
  }
})
