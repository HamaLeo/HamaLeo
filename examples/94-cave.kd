// یاری: هێلیکۆپتەر 🚁 — ماوس/بۆشایی دابگرە بۆ بەرزبوونەوە، بەریبدە بۆ نزمبوونەوە. لە دیوارەکانی ئەشکەوتەکە بەر مەکەوە!
قەبارە(٥٠٠، ٣٠٠)
گۆڕاو سەرەوەکان = []
گۆڕاو خوارەوەکان = []
گۆڕاو y = ١٥٠
گۆڕاو vy = ٠
گۆڕاو مەودا = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو بەرزترین = ٠
گۆڕاو ناوەند = ١٥٠
گۆڕاو بۆشایی = ١٨٠
گۆڕاو کات = ٠

کار ستوونی_نوێ() {
  ناوەند = سنوور(ناوەند + هەڕەمەکی(-٥، ٥)، ٩٠، ٢١٠)
  بۆشایی = گەورەترین(١١٠، بۆشایی - ٠٫٠٥)
  سەرەوەکان.زیادبکە(ناوەند - بۆشایی / ٢)
  خوارەوەکان.زیادبکە(ناوەند + بۆشایی / ٢)
}

کار دووبارە() {
  سەرەوەکان = []؛ خوارەوەکان = []؛ y = ١٥٠؛ vy = ٠؛ مەودا = ٠؛ مردووە = هەڵە؛ ناوەند = ١٥٠؛ بۆشایی = ١٨٠
  بۆ i لە ١ تا ٥٠ { ستوونی_نوێ() }
}
دووبارە()

یاریبکە(() => {
  کات += ١
  ئەگەر نەک مردووە {
    ئەگەر کلیل("بۆشایی") یان ماوسگیراوە() { vy -= ٠٫٤ } ئەگەرنا { vy += ٠٫٣ }
    vy = سنوور(vy، -٥، ٥)
    y += vy
    مەودا += ١
    سەرەوەکان.یەکەمیلابەرە()؛ خوارەوەکان.یەکەمیلابەرە()
    ستوونی_نوێ()
    نەگۆڕ ک = ١٠
    ئەگەر y - ١٢ < سەرەوەکان[ک] یان y + ١٢ > خوارەوەکان[ک] { مردووە = ڕاست }
    بەرزترین = گەورەترین(بەرزترین، خوارکە(مەودا / ١٠))
  } ئەگەرنا ئەگەر کلیککراوە() { دووبارە() }

  پاشبنەمابکە(ڕەنگی(٢٠، ١٥، ٢٥))
  بۆ i لە ٠ تا ٤٩ {
    ڕەنگبکە(ڕەنگی(٦٠، ٥٠، ٨٠))
    لاکێش(i * ١٠، ٠، ١٠، سەرەوەکان[i])
    لاکێش(i * ١٠، خوارەوەکان[i]، ١٠، ٣٠٠ - خوارەوەکان[i])
    ڕەنگبکە(ڕەنگی(٩٠، ٨٠، ١١٠))
    لاکێش(i * ١٠، سەرەوەکان[i] - ٣، ١٠، ٣)
    لاکێش(i * ١٠، خوارەوەکان[i]، ١٠، ٣)
  }
  ڕەنگبکە("زەرد")
  لاکێش(٩٠، y - ٦، ٣٠، ١٢)
  لاکێش(٨٠، y - ٢، ١٥، ٤)
  بازنە(١٠٥، y، ٨)
  هێڵڕەنگبکە("سپی")
  ئەستووریبکە(٢)
  هێڵ(٨٥، y - ١٠، ١٢٥، y - ١٠)
  ڕەنگبکە("سپی")
  نووسین("مەودا: " + خوارکە(مەودا / ١٠)، ١٠، ٢٥، ٢٠)
  نووسین("باشترین: " + بەرزترین، ٣٧٠، ٢٥، ١٦)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٥٠٠، ٣٠٠)
    ڕەنگبکە("سپی")
    نووسین("کەوتیت! " + خوارکە(مەودا / ١٠) + " مەتر", ١٦٠، ١٣٠، ٣٠)
    نووسین("کلیک = دووبارە", ٢٠٠، ١٧٠، ٢٠)
  }
})
