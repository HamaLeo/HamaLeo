// 🌀 تونێل — چوارگۆشەی ڕەنگاوڕەنگ کە دەسووڕێنەوە و بەرەو ناوەوە دەڕۆن. ماوس بجووڵێنە بۆ گۆڕینی سووڕان
قەبارە(٤٠٠، ٤٠٠)
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠٢
  نەگۆڕ پێچ = ماوسX() >= ٠ ? (ماوسX() - ٢٠٠) / ١٠٠٠ : ٠٫٠٦
  پاشبنەمابکە("ڕەش")
  ئەستووریبکە(٣)
  بۆ i لە ٢٩ تا ٠ هەنگاو -١ {
    نەگۆڕ فاز = (i + (کات * ٥) % ١) / ٣٠
    نەگۆڕ قەبارە = توان(فاز، ٢) * ٣٠٠
    نەگۆڕ گ = i * پێچ + کات
    هێڵڕەنگبکە(پەلکەزێڕینە(i * ١٢ + کات * ١٠٠، فاز + ٠٫١))
    نەگۆڕ ک = [[-١، -١]، [١، -١]، [١، ١]، [-١، ١]]
    بۆ j لە ٠ تا ٣ {
      نەگۆڕ a = ک[j]
      نەگۆڕ b = ک[(j + ١) % ٤]
      هێڵ(٢٠٠ + (a[٠] * کۆسینۆس(گ) - a[١] * سینۆس(گ)) * قەبارە، ٢٠٠ + (a[٠] * سینۆس(گ) + a[١] * کۆسینۆس(گ)) * قەبارە،
          ٢٠٠ + (b[٠] * کۆسینۆس(گ) - b[١] * سینۆس(گ)) * قەبارە، ٢٠٠ + (b[٠] * سینۆس(گ) + b[١] * کۆسینۆس(گ)) * قەبارە)
    }
  }
})
