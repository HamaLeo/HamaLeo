// یاری: تیرهاوێژی 🏹 — ماوس بجووڵێنە بۆ ئامانج، ماوس دابگرە بۆ هێز و بەریبدە بۆ هاویشتن. ٥ تیرت هەیە!
قەبارە(٥٠٠، ٣٢٠)
نەگۆڕ کەوانx = ٦٠
نەگۆڕ کەوانy = ٢٣٠
گۆڕاو تیر = هیچ
گۆڕاو هێز = ٠
گۆڕاو پێشوو = هەڵە
گۆڕاو ئامانج = ١٥٠
گۆڕاو ئامانجخ = ١٫٥
گۆڕاو خاڵ = ٠
گۆڕاو ماوە = ٥
گۆڕاو دوایینخاڵ = -١
گۆڕاو چاوەڕێ = ٠

کار ئاڕاستە() {
  نەگۆڕ d = گەورەترین(دووری(کەوانx، کەوانy، ماوسX()، ماوسY())، ١)
  گەڕێنەوە { x: (ماوسX() - کەوانx) / d، y: (ماوسY() - کەوانy) / d }
}

یاریبکە(() => {
  ئامانج += ئامانجخ
  ئەگەر ئامانج > ٢٧٠ یان ئامانج < ٥٠ { ئامانجخ = -ئامانجخ }
  چاوەڕێ -= ١

  ئەگەر ماوە > ٠ و نەک تیر و چاوەڕێ <= ٠ {
    ئەگەر ماوسگیراوە() { هێز = بچووکترین(٦٠، هێز + ١) }
    ئەگەر پێشوو و نەک ماوسگیراوە() و هێز > ٥ {
      نەگۆڕ ئا = ئاڕاستە()
      تیر = { x: کەوانx، y: کەوانy، vx: ئا.x * هێز * ٠٫٣، vy: ئا.y * هێز * ٠٫٣ }
      ماوە -= ١؛ هێز = ٠
    }
  }
  پێشوو = ماوسگیراوە()

  ئەگەر تیر {
    تیر.vy += ٠٫١٥
    تیر.x += تیر.vx؛ تیر.y += تیر.vy
    ئەگەر تیر.x >= ٤٣٠ و تیر.x <= ٤٤٠ {
      نەگۆڕ ج = ڕەها(تیر.y - ئامانج)
      ئەگەر ج < ٤٥ {
        دوایینخاڵ = ج < ٥ ? ١٠ : ج < ١٥ ? ٧ : ج < ٢٥ ? ٥ : ٢
        خاڵ += دوایینخاڵ؛ تیر = هیچ؛ چاوەڕێ = ٣٠
      }
    }
    ئەگەر تیر و (تیر.x > ٥٠٠ یان تیر.y > ٣٢٠) { دوایینخاڵ = ٠؛ تیر = هیچ؛ چاوەڕێ = ٣٠ }
  }

  پاشبنەمابکە(ڕەنگی(١٣٥، ٢٠٦، ٢٣٥))
  ڕەنگبکە(ڕەنگی(٩٠، ١٦٠، ٧٠))
  لاکێش(٠، ٢٧٠، ٥٠٠، ٥٠)
  // ئامانج
  ڕەنگبکە(ڕەنگی(١٢٠، ٨٠، ٤٠))
  لاکێش(٤٣٥، ئامانج، ٦، ٣٢٠ - ئامانج)
  ڕەنگبکە("سوور")؛ بازنە(٤٣٨، ئامانج، ٤٥)
  ڕەنگبکە("سپی")؛ بازنە(٤٣٨، ئامانج، ٣٥)
  ڕەنگبکە("سوور")؛ بازنە(٤٣٨، ئامانج، ٢٥)
  ڕەنگبکە("سپی")؛ بازنە(٤٣٨، ئامانج، ١٥)
  ڕەنگبکە("زەرد")؛ بازنە(٤٣٨، ئامانج، ٥)
  // کەوان
  ڕەنگبکە(ڕەنگی(٩٠، ٦٠، ٣٠))
  لاکێش(کەوانx - ٤، کەوانy - ٣٠، ٨، ٦٠)
  ڕەنگبکە("قاوەیی")؛ بازنە(کەوانx، کەوانy + ٣٠، ٦)
  // هێڵی ئاڕاستە
  ئەگەر ماوسگیراوە() و ماوە > ٠ و نەک تیر {
    نەگۆڕ ئا = ئاڕاستە()
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٧))
    گۆڕاو px = کەوانx
    گۆڕاو py = کەوانy
    گۆڕاو pvx = ئا.x * هێز * ٠٫٣
    گۆڕاو pvy = ئا.y * هێز * ٠٫٣
    بۆ i لە ١ تا ٢٥ { pvy += ٠٫١٥؛ px += pvx؛ py += pvy؛ ئەگەر i % ٢ == ٠ { بازنە(px، py، ٢) } }
  }
  ئەگەر تیر {
    هێڵڕەنگبکە("ڕەش")؛ ئەستووریبکە(٣)
    هێڵ(تیر.x، تیر.y، تیر.x - تیر.vx * ٣، تیر.y - تیر.vy * ٣)
  }
  ڕەنگبکە("سپی")
  لاکێش(٢٠، ٢٩٥، ١٠٠، ١٠)
  ڕەنگبکە("زەرد")
  لاکێش(٢٠، ٢٩٥، هێز * ١٠٠ / ٦٠، ١٠)
  ڕەنگبکە("ڕەش")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٥، ٢٠)
  نووسین("تیر: " + ماوە، ٣٩٠، ٢٥، ٢٠)
  ئەگەر دوایینخاڵ >= ٠ و چاوەڕێ > ٠ { نووسین(دوایینخاڵ > ٠ ? "+" + دوایینخاڵ : "نەپێکا", ٢٠٠، ١٥٠، ٣٠) }
  ئەگەر ماوە == ٠ و نەک تیر و چاوەڕێ <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٥٠٠، ٣٢٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! خاڵ: " + خاڵ، ١٦٠، ١٤٠، ٣٠)
    نووسین("کلیک = دووبارە", ٢٠٠، ١٨٠، ٢٠)
    ئەگەر کلیککراوە() { خاڵ = ٠؛ ماوە = ٥؛ دوایینخاڵ = -١ }
  }
})
