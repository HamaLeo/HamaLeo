// یاری: مین‌ڕووت 💣 — کلیک بکە بۆ کردنەوەی خانە. F دابگرە و کلیک بکە بۆ ئاڵا. ژمارە = چەند مین لە دەوریدا هەیە
قەبارە(٣٦٠، ٤٠٠)
نەگۆڕ مەتر = ٩
نەگۆڕ مینەکان_ژمارە = ١٠
گۆڕاو مینەکان = []
گۆڕاو کراوەتەوە = []
گۆڕاو ئاڵا = []
گۆڕاو دۆخ = "چاوەڕێ"       // چاوەڕێ، یاری، بردرا، دۆڕا
گۆڕاو کات = ٠

کار دەستپێکردن() {
  مینەکان = []؛ کراوەتەوە = []؛ ئاڵا = []
  بۆ i لە ١ تا مەتر * مەتر { مینەکان.زیادبکە(هەڵە)؛ کراوەتەوە.زیادبکە(هەڵە)؛ ئاڵا.زیادبکە(هەڵە) }
  دۆخ = "چاوەڕێ"؛ کات = ٠
}
دەستپێکردن()

کار ژمارەی_دراوسێ(x، y) {
  گۆڕاو ژ = ٠
  بۆ dy لە -١ تا ١ { بۆ dx لە -١ تا ١ {
    نەگۆڕ nx = x + dx
    نەگۆڕ ny = y + dy
    ئەگەر nx >= ٠ و nx < مەتر و ny >= ٠ و ny < مەتر و مینەکان[ny * مەتر + nx] { ژ += ١ }
  } }
  گەڕێنەوە ژ
}

کار مینەکان_دابنێ(بێجگە) {
  گۆڕاو دانراو = ٠
  هەتا دانراو < مینەکان_ژمارە {
    نەگۆڕ i = هەڕەمەکی(٠، مەتر * مەتر - ١)
    نەگۆڕ دوورە = ڕەها(i % مەتر - بێجگە % مەتر) > ١ یان ڕەها(خوارکە(i / مەتر) - خوارکە(بێجگە / مەتر)) > ١
    ئەگەر نەک مینەکان[i] و دوورە { مینەکان[i] = ڕاست؛ دانراو += ١ }
  }
}

کار بکەرەوە(x، y) {
  نەگۆڕ ڕیز = [[x، y]]
  هەتا ڕیز.درێژی > ٠ {
    نەگۆڕ ش = ڕیز.لابەرە()
    نەگۆڕ i = ش[١] * مەتر + ش[٠]
    ئەگەر ش[٠] >= ٠ و ش[٠] < مەتر و ش[١] >= ٠ و ش[١] < مەتر و نەک کراوەتەوە[i] و نەک ئاڵا[i] {
      کراوەتەوە[i] = ڕاست
      ئەگەر ژمارەی_دراوسێ(ش[٠]، ش[١]) == ٠ {
        بۆ dy لە -١ تا ١ { بۆ dx لە -١ تا ١ { ڕیز.زیادبکە([ش[٠] + dx، ش[١] + dy]) } }
      }
    }
  }
}

یاریبکە(() => {
  کات += ١
  ئەگەر کلیککراوە() و ماوسY() >= ٤٠ {
    نەگۆڕ x = خوارکە(ماوسX() / ٤٠)
    نەگۆڕ y = خوارکە((ماوسY() - ٤٠) / ٤٠)
    نەگۆڕ i = y * مەتر + x
    ئەگەر x < مەتر و y < مەتر {
      ئەگەر دۆخ == "چاوەڕێ" یان دۆخ == "یاری" {
        ئەگەر کلیل("f") {
          ئەگەر نەک کراوەتەوە[i] { ئاڵا[i] = نەک ئاڵا[i] }
        } ئەگەرنا ئەگەر نەک ئاڵا[i] {
          ئەگەر دۆخ == "چاوەڕێ" { مینەکان_دابنێ(i)؛ دۆخ = "یاری" }
          ئەگەر مینەکان[i] { دۆخ = "دۆڕا" } ئەگەرنا { بکەرەوە(x، y) }
          ئەگەر دۆخ == "یاری" و کراوەتەوە.پاڵاوتن(v => v).درێژی == مەتر * مەتر - مینەکان_ژمارە { دۆخ = "بردرا" }
        }
      }
    }
  } ئەگەرنا ئەگەر کلیککراوە() و (دۆخ == "دۆڕا" یان دۆخ == "بردرا") { دەستپێکردن() }

  پاشبنەمابکە(ڕەنگی(٣٥، ٤٠، ٦٠))
  بۆ y لە ٠ تا مەتر - ١ {
    بۆ x لە ٠ تا مەتر - ١ {
      نەگۆڕ i = y * مەتر + x
      نەگۆڕ X = x * ٤٠
      نەگۆڕ Y = y * ٤٠ + ٤٠
      ئەگەر کراوەتەوە[i] {
        ڕەنگبکە(ڕەنگی(٢٢٠، ٢٢٥، ٢٣٥))
        لاکێش(X + ١، Y + ١، ٣٨، ٣٨)
        نەگۆڕ ژ = ژمارەی_دراوسێ(x، y)
        ئەگەر ژ > ٠ { ڕەنگبکە(ژ == ١ ? "شین" : ژ == ٢ ? "سەوز" : "سوور")؛ نووسین(ژ، X + ١٣، Y + ٢٩، ٢٤) }
      } ئەگەرنا {
        ڕەنگبکە(ڕەنگی(٩٠، ١٠٠، ١٥٠))
        لاکێش(X + ١، Y + ١، ٣٨، ٣٨)
        ئەگەر ئاڵا[i] { ڕەنگبکە("سوور")؛ سێگۆشە(X + ١٠، Y + ٨، X + ١٠، Y + ٢٤، X + ٢٨، Y + ١٦)؛ ڕەنگبکە("ڕەش")؛ لاکێش(X + ٩، Y + ٨، ٣، ٢٤) }
      }
      ئەگەر دۆخ == "دۆڕا" و مینەکان[i] {
        ڕەنگبکە("ڕەش")؛ بازنە(X + ٢٠، Y + ٢٠، ١٠)
        ڕەنگبکە("سپی")؛ بازنە(X + ١٦، Y + ١٦، ٣)
      }
    }
  }
  ڕەنگبکە("سپی")
  نووسین("مین: " + (مینەکان_ژمارە - ئاڵا.پاڵاوتن(v => v).درێژی)، ١٠، ٢٧، ٢٠)
  نووسین(دۆخ == "بردرا" ? "🎉 بردتەوە! کلیک = دووبارە" : دۆخ == "دۆڕا" ? "💥 مینەکە! کلیک = دووبارە" : "F + کلیک = ئاڵا", ١٣٠، ٢٧، ١٦)
})
