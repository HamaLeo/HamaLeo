// یاری: تانکەکان 💥 — ↑ ↓ گۆشە، ← → هێز، بۆشایی = تەقە. تانکی سوور بتەقێنە پێش ئەوەی ئەو تۆ بتەقێنێت! (٣ لێدان)
قەبارە(٥٠٠، ٣٢٠)
گۆڕاو زەوی = []
گۆڕاو تانک = { x: ٦٠، گۆشە: ٤٥، هێز: ٥٠، ژیان: ٣ }
گۆڕاو دوژمن = { x: ٤٤٠، ژیان: ٣ }
گۆڕاو گوللە = هیچ
گۆڕاو نۆرە = "تۆ"           // تۆ، دوژمن، تەواو
گۆڕاو با = ٠
گۆڕاو چاوەڕێ = ٠
گۆڕاو پەیام = ""
گۆڕاو پێشوو = هەڵە

کار بەرزی(x) { گەڕێنەوە زەوی[سنوور(خوارکە(x)، ٠، ٤٩٩)] }

کار نەخشە_نوێ() {
  زەوی = []
  نەگۆڕ a = هەڕەمەکی(٠، ٣٦٠)
  بۆ x لە ٠ تا ٤٩٩ { زەوی.زیادبکە(٢١٠ + سینۆس((x + a) / ٦٠) * ٣٠ + سینۆس((x + a * ٢) / ٢٣) * ١٠) }
  با = هەڕەمەکی(-٥، ٥) / ٣٠
}

کار دەستپێکردن() { نەخشە_نوێ()؛ تانک.ژیان = ٣؛ دوژمن.ژیان = ٣؛ نۆرە = "تۆ"؛ گوللە = هیچ؛ پەیام = "" }
دەستپێکردن()

کار تەقە(لە، گۆشە، هێز، ئاڕاستە) {
  نەگۆڕ g = گۆشە * پای / ١٨٠
  گوللە = { x: لە.x، y: بەرزی(لە.x) - ١٥، vx: کۆسینۆس(g) * هێز / ٨ * ئاڕاستە، vy: -سینۆس(g) * هێز / ٨، ئاڕاستە: ئاڕاستە }
}

کار تەقینەوە(x، y) {
  بۆ i لە -٢٥ تا ٢٥ { نەگۆڕ ک = سنوور(خوارکە(x) + i، ٠، ٤٩٩)؛ زەوی[ک] += گەورەترین(٠، ٢٠ - ڕەها(i) * ٠٫٨) }
  ئەگەر دووری(x، y، دوژمن.x، بەرزی(دوژمن.x)) < ٣٥ { دوژمن.ژیان -= ١ }
  ئەگەر دووری(x، y، تانک.x، بەرزی(تانک.x)) < ٣٥ { تانک.ژیان -= ١ }
}

یاریبکە(() => {
  ئەگەر نۆرە == "تۆ" و نەک گوللە {
    ئەگەر کلیل("سەرەوە") { تانک.گۆشە = بچووکترین(٨٥، تانک.گۆشە + ١) }
    ئەگەر کلیل("خوارەوە") { تانک.گۆشە = گەورەترین(٥، تانک.گۆشە - ١) }
    ئەگەر کلیل("چەپ") { تانک.هێز = گەورەترین(١٠، تانک.هێز - ١) }
    ئەگەر کلیل("ڕاست") { تانک.هێز = بچووکترین(١٠٠، تانک.هێز + ١) }
    ئەگەر کلیل("بۆشایی") و نەک پێشوو { تەقە(تانک، تانک.گۆشە، تانک.هێز، ١) }
  }
  پێشوو = کلیل("بۆشایی")
  ئەگەر نۆرە == "دوژمن" و نەک گوللە {
    چاوەڕێ -= ١
    ئەگەر چاوەڕێ <= ٠ { تەقە(دوژمن، هەڕەمەکی(٣٠، ٦٠)، هەڕەمەکی(٤٥، ٨٠)، -١) }
  }
  ئەگەر گوللە {
    گوللە.vy += ٠٫٠٨؛ گوللە.vx += با
    گوللە.x += گوللە.vx؛ گوللە.y += گوللە.vy
    ئەگەر گوللە.x < ٠ یان گوللە.x > ٥٠٠ یان گوللە.y > بەرزی(گوللە.x) {
      تەقینەوە(گوللە.x، گوللە.y)
      نەگۆڕ لە_تۆ = گوللە.ئاڕاستە == ١
      گوللە = هیچ
      ئەگەر دوژمن.ژیان <= ٠ { نۆرە = "تەواو"؛ پەیام = "بردتەوە! 🎉" } ئەگەرنا ئەگەر تانک.ژیان <= ٠ { نۆرە = "تەواو"؛ پەیام = "دۆڕاویت" } ئەگەرنا {
        نۆرە = لە_تۆ ? "دوژمن" : "تۆ"؛ چاوەڕێ = ٦٠
        با = هەڕەمەکی(-٥، ٥) / ٣٠
      }
    }
  }
  ئەگەر نۆرە == "تەواو" و کلیککراوە() { دەستپێکردن() }

  پاشبنەمابکە(ڕەنگی(١٣٥، ٢٠٦، ٢٣٥))
  ڕەنگبکە(ڕەنگی(٩٠، ١٤٠، ٧٠))
  بۆ x لە ٠ تا ٤٩٩ { لاکێش(x، زەوی[x]، ١٫٥، ٣٢٠ - زەوی[x]) }
  نەگۆڕ ت = [[تانک.x، "ئاسمانی"، ١]، [دوژمن.x، "سوور"، -١]]
  بۆ هەر ڕ لە ت {
    نەگۆڕ y = بەرزی(ڕ[٠])
    ڕەنگبکە(ڕ[١])
    لاکێش(ڕ[٠] - ١٨، y - ١٢، ٣٦، ١٢)
    بازنە(ڕ[٠]، y - ١٢، ٩)
  }
  هێڵڕەنگبکە("ڕەش")
  ئەستووریبکە(٥)
  نەگۆڕ gg = تانک.گۆشە * پای / ١٨٠
  هێڵ(تانک.x، بەرزی(تانک.x) - ١٨، تانک.x + کۆسینۆس(gg) * ٢٠، بەرزی(تانک.x) - ١٨ - سینۆس(gg) * ٢٠)
  هێڵ(دوژمن.x، بەرزی(دوژمن.x) - ١٨، دوژمن.x - ٢٠، بەرزی(دوژمن.x) - ٢٥)
  ئەگەر گوللە { ڕەنگبکە("ڕەش")؛ بازنە(گوللە.x، گوللە.y، ٤) }
  ڕەنگبکە("سپی")
  نووسین("گۆشە: " + تانک.گۆشە + "°   هێز: " + تانک.هێز، ١٠، ٢٥، ١٨)
  نووسین("ژیانی تۆ: " + تانک.ژیان + "   دوژمن: " + دوژمن.ژیان، ٣٠٠، ٢٥، ١٨)
  نووسین("با: " + (با > ٠ ? "→" : "←") + گردبکە(ڕەها(با) * ٣٠٠)، ٢١٠، ٥٠، ١٦)
  ئەگەر نۆرە == "دوژمن" و نەک گوللە { نووسین("دوژمن ئامانج دەگرێت...", ١٨٠، ٨٠، ٢٠) }
  ئەگەر نۆرە == "تەواو" { نووسین(پەیام + " — کلیک = دووبارە", ١٢٠، ١٢٠، ٢٦) }
})
