// ✨ کرمە شەوتاو — ٥٠ کرمی گەش لە شەودا دەگەڕێن. ماوس = تۆڕێکی ڕووناک کە ڕایاندەکێشێت
قەبارە(٤٥٠، ٣٢٠)
نەگۆڕ کرمەکان = []
بۆ i لە ١ تا ٥٠ { کرمەکان.زیادبکە({ x: هەڕەمەکی(٠، ٤٥٠)، y: هەڕەمەکی(٠، ٣٢٠)، ف: هەڕەمەکی(٠، ٦٠٠) / ١٠٠، vx: هەڕەمەکی(-٥، ٥) / ١٠، vy: هەڕەمەکی(-٥، ٥) / ١٠ }) }
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ١
  پاشبنەمابکە(ڕەنگی(٥، ١٠، ٢٠))
  ڕەنگبکە(ڕەنگی(١٥، ٣٠، ٢٠))
  سێگۆشە(٠، ٣٢٠، ٨٠، ٢٥٠، ١٦٠، ٣٢٠)
  سێگۆشە(١٢٠، ٣٢٠، ٢٥٠، ٢٣٠، ٣٨٠، ٣٢٠)
  سێگۆشە(٣٠٠، ٣٢٠، ٣٩٠، ٢٦٠، ٤٥٠، ٣٢٠)
  بۆ هەر ک لە کرمەکان {
    ک.vx += هەڕەمەکی(-١، ١) / ٢٠؛ ک.vy += هەڕەمەکی(-١، ١) / ٢٠
    ئەگەر ماوسX() >= ٠ {
      نەگۆڕ د = گەورەترین(دووری(ک.x، ک.y، ماوسX()، ماوسY())، ١)
      ئەگەر د < ٢٠٠ { ک.vx += (ماوسX() - ک.x) / د * ٠٫٠٣؛ ک.vy += (ماوسY() - ک.y) / د * ٠٫٠٣ }
    }
    ک.vx = سنوور(ک.vx، -١٫٥، ١٫٥)؛ ک.vy = سنوور(ک.vy، -١٫٥، ١٫٥)
    ک.x = ((ک.x + ک.vx) % ٤٥٠ + ٤٥٠) % ٤٥٠؛ ک.y = ((ک.y + ک.vy) % ٣٢٠ + ٣٢٠) % ٣٢٠
    نەگۆڕ گەشی = (سینۆس(کات / ٢٠ + ک.ف) + ١) / ٢
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٣٠، ٨٠، ٠٫٠٦ + ٠٫٠٦ * گەشی))
    بازنە(ک.x، ک.y، ١٦)
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٤٠، ١٠٠، ٠٫٢ + ٠٫٣ * گەشی))
    بازنە(ک.x، ک.y، ٧)
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٠٠))
    بازنە(ک.x، ک.y، ٢)
  }
})
