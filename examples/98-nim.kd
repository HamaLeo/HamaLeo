// یاری: نیم 🥢 — هەر نۆرەیەک ١ تا ٣ چێوی بگرە. ئەوەی دوایین چێو دەگرێت دەباتەوە! (ڕاز: هەمیشە ببە بە چێوی ژمارە دابەشبوو بەسەر ٤ جێ بهێڵە)
قەبارە(٤٥٠، ٣٢٠)
گۆڕاو چێوەکان = ٢٢
گۆڕاو نۆرە = "تۆ"      // تۆ، کۆمپیوتەر، تەواو
گۆڕاو براوە = ""
گۆڕاو چاوەڕێ = ٠
گۆڕاو دوایین_گرتن = ٠

کار دەستپێکردن() { چێوەکان = ٢١ + هەڕەمەکی(٠، ٢)؛ نۆرە = "تۆ"؛ براوە = ""؛ دوایین_گرتن = ٠ }
دەستپێکردن()

کار بگرە(ژمارە، کێ) {
  چێوەکان -= ژمارە؛ دوایین_گرتن = ژمارە
  ئەگەر چێوەکان <= ٠ { براوە = کێ؛ نۆرە = "تەواو" } ئەگەرنا { نۆرە = کێ == "تۆ" ? "کۆمپیوتەر" : "تۆ"؛ چاوەڕێ = ٥٠ }
}

یاریبکە(() => {
  ئەگەر نۆرە == "تۆ" و کلیککراوە() و ماوسY() > ٢٣٠ {
    نەگۆڕ ب = خوارکە(ماوسX() / ١٥٠) + ١
    ئەگەر ب >= ١ و ب <= ٣ و ب <= چێوەکان { بگرە(ب، "تۆ") }
  } ئەگەرنا ئەگەر نۆرە == "کۆمپیوتەر" {
    چاوەڕێ -= ١
    ئەگەر چاوەڕێ <= ٠ {
      گۆڕاو ژ = چێوەکان % ٤
      ئەگەر ژ == ٠ { ژ = هەڕەمەکی(١، بچووکترین(٣، چێوەکان)) }
      بگرە(ژ، "کۆمپیوتەر")
    }
  } ئەگەرنا ئەگەر نۆرە == "تەواو" و کلیککراوە() { دەستپێکردن() }

  پاشبنەمابکە(ڕەنگی(٢٥، ٣٠، ٤٥))
  بۆ i لە ٠ تا چێوەکان - ١ {
    ڕەنگبکە(ڕەنگی(٢٢٠، ١٨٠، ١٠٠))
    لاکێش(٢٠ + (i % ١١) * ٣٩، ٥٠ + خوارکە(i / ١١) * ٧٥، ١٢، ٦٠)
    ڕەنگبکە(ڕەنگی(١٨٠، ٣٠، ٣٠))
    لاکێش(٢٠ + (i % ١١) * ٣٩، ٥٠ + خوارکە(i / ١١) * ٧٥، ١٢، ١٢)
  }
  بۆ ب لە ١ تا ٣ {
    ڕەنگبکە(نۆرە == "تۆ" و ب <= چێوەکان ? ڕەنگی(٦٠، ١٢٠، ٢٢٠) : ڕەنگی(٥٠، ٥٥، ٨٠))
    لاکێش((ب - ١) * ١٥٠ + ١٠، ٢٤٠، ١٣٠، ٥٠)
    ڕەنگبکە("سپی")
    نووسین("بگرە " + ب، (ب - ١) * ١٥٠ + ٣٥، ٢٧٢، ٢٠)
  }
  ڕەنگبکە("سپی")
  نووسین("چێوەکان: " + چێوەکان، ١٠، ٢٥، ٢٤)
  نووسین(نۆرە == "تۆ" ? "نۆرەی تۆیە" : نۆرە == "کۆمپیوتەر" ? "کۆمپیوتەر بیر دەکاتەوە..." : "", ٢٥٠، ٢٥، ٢٠)
  ئەگەر دوایین_گرتن > ٠ و نۆرە != "تەواو" { نووسین("دوایین گرتن: " + دوایین_گرتن، ٢٥٠، ٤٥، ١٤) }
  ئەگەر نۆرە == "تەواو" {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٤٥٠، ٣٢٠)
    ڕەنگبکە("سپی")
    نووسین(براوە == "تۆ" ? "بردتەوە! 🎉" : "کۆمپیوتەر بردیەوە", ١٤٠، ١٤٠، ٣٠)
    نووسین("کلیک = دووبارە", ١٦٠، ١٨٠، ٢٠)
  }
})
