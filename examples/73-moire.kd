// 🔘 مواریە — دوو کۆمەڵە بازنەی هاوناوەند یەک دەگرن و شێوەی نوێ دروست دەکەن. ماوس بجووڵێنە بۆ جووڵاندنی بازنەکانی دووەم
قەبارە(٤٠٠، ٣٢٠)
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠٢
  نەگۆڕ mx = ماوسX() >= ٠ ? ماوسX() : ٢٠٠ + سینۆس(کات) * ٦٠
  نەگۆڕ my = ماوسY() >= ٠ ? ماوسY() : ١٦٠ + کۆسینۆس(کات * ١٫٣) * ٤٠
  پاشبنەمابکە(ڕەنگی(١٠، ١٠، ٢٠))
  ئەستووریبکە(١)
  هێڵڕەنگبکە(ڕەنگی(٢٥٥، ٢٣٠، ١٥٠، ٠٫٨))
  بۆ i لە ١ تا ٥٠ { بازنەهێڵ(١٣٠، ١٦٠، i * ٦) }
  هێڵڕەنگبکە(ڕەنگی(١٥٠، ٢٠٠، ٢٥٥، ٠٫٨))
  بۆ i لە ١ تا ٥٠ { بازنەهێڵ(mx، my، i * ٦) }
})
