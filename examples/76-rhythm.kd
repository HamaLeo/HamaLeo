// یاری: ڕیتم 🎵 — نۆتەکان کاتێک گەیشتنە هێڵی خوارەوە کلیلی D F J K دابگرە (یان کلیک لەسەر ستوونەکە). ٦٠ نۆتە هەیە!
قەبارە(٣٦٠، ٤٤٠)
نەگۆڕ کلیلەکان = ["d"، "f"، "j"، "k"]
نەگۆڕ ڕەنگەکان = [٠، ٦٠، ١٢٠، ٢٠٠]
گۆڕاو نۆتەکان = []
گۆڕاو خاڵ = ٠
گۆڕاو کۆمبۆ = ٠
گۆڕاو باشترین_کۆمبۆ = ٠
گۆڕاو دروستکراو = ٠
گۆڕاو کات = ٠
گۆڕاو پێشوو = [هەڵە، هەڵە، هەڵە، هەڵە]
گۆڕاو هەڵسەنگاندن = ""
گۆڕاو هەڵسەنگاندنکات = ٠
نەگۆڕ هێڵ = ٣٧٠

کار دووبارە() { نۆتەکان = []؛ خاڵ = ٠؛ کۆمبۆ = ٠؛ باشترین_کۆمبۆ = ٠؛ دروستکراو = ٠؛ کات = ٠؛ هەڵسەنگاندن = "" }

کار لێدان(هێڵی_لایەن) {
  گۆڕاو نزیکترین = هیچ
  بۆ هەر ن لە نۆتەکان {
    ئەگەر ن.لایەن == هێڵی_لایەن و نەک ن.لێدراوە و ڕەها(ن.y - هێڵ) < ٣٥ {
      ئەگەر نەک نزیکترین یان ڕەها(ن.y - هێڵ) < ڕەها(نزیکترین.y - هێڵ) { نزیکترین = ن }
    }
  }
  ئەگەر نزیکترین {
    نزیکترین.لێدراوە = ڕاست
    نەگۆڕ جیاوازی = ڕەها(نزیکترین.y - هێڵ)
    کۆمبۆ += ١
    باشترین_کۆمبۆ = گەورەترین(باشترین_کۆمبۆ، کۆمبۆ)
    ئەگەر جیاوازی < ١٢ { خاڵ += ١٠٠ + کۆمبۆ * ٥؛ هەڵسەنگاندن = "تەواو!" } ئەگەرنا { خاڵ += ٥٠؛ هەڵسەنگاندن = "باش" }
  } ئەگەرنا { کۆمبۆ = ٠؛ هەڵسەنگاندن = "هەڵە" }
  هەڵسەنگاندنکات = ٣٠
}

یاریبکە(() => {
  کات += ١
  هەڵسەنگاندنکات -= ١
  ئەگەر دروستکراو < ٦٠ و کات % ٢٢ == ٠ {
    نۆتەکان.زیادبکە({ لایەن: هەڕەمەکی(٠، ٣)، y: -٢٠ })
    دروستکراو += ١
  }
  بۆ هەر ن لە نۆتەکان {
    ن.y += ٥
    ئەگەر ن.y > هێڵ + ٤٠ و نەک ن.لێدراوە { ن.لێدراوە = ڕاست؛ کۆمبۆ = ٠؛ هەڵسەنگاندن = "نەگیرا"؛ هەڵسەنگاندنکات = ٣٠ }
  }
  نۆتەکان = نۆتەکان.پاڵاوتن(ن => ن.y < هێڵ + ٦٠ و نەک (ن.لێدراوە و ن.y > هێڵ + ٤٠))
  بۆ i لە ٠ تا ٣ {
    نەگۆڕ دابگیراوە = کلیل(کلیلەکان[i])
    ئەگەر دابگیراوە و نەک پێشوو[i] { لێدان(i) }
    پێشوو[i] = دابگیراوە
  }
  ئەگەر کلیککراوە() و ماوسY() > ٢٠٠ { لێدان(سنوور(خوارکە(ماوسX() / ٩٠)، ٠، ٣)) }
  ئەگەر دروستکراو >= ٦٠ و نۆتەکان.درێژی == ٠ و کلیککراوە() { دووبارە() }

  پاشبنەمابکە(ڕەنگی(١٠، ١٠، ٢٥))
  بۆ i لە ٠ تا ٣ {
    ڕەنگبکە(ڕەنگی(٢٠ + i * ٥، ٢٠ + i * ٥، ٤٥))
    لاکێش(i * ٩٠ + ٢، ٠، ٨٦، ٤٤٠)
    ڕەنگبکە(پەلکەزێڕینە(ڕەنگەکان[i]، پێشوو[i] ? ٠٫٦ : ٠٫٢))
    لاکێش(i * ٩٠ + ٢، هێڵ - ٢٠، ٨٦، ٤٠)
    ڕەنگبکە("سپی")
    نووسین(کلیلەکان[i].گەورەبکە()، i * ٩٠ + ٣٥، ٤٢٠، ٢٠)
  }
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٦))
  لاکێش(٠، هێڵ - ١، ٣٦٠، ٢)
  بۆ هەر ن لە نۆتەکان {
    ڕەنگبکە(ن.لێدراوە ? ڕەنگی(٨٠، ٨٠، ٨٠، ٠٫٤) : پەلکەزێڕینە(ڕەنگەکان[ن.لایەن]))
    لاکێش(ن.لایەن * ٩٠ + ٦، ن.y - ١٠، ٧٨، ٢٠)
  }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٥، ٢٠)
  نووسین("کۆمبۆ: " + کۆمبۆ، ٢٤٠، ٢٥، ٢٠)
  ئەگەر هەڵسەنگاندنکات > ٠ { نووسین(هەڵسەنگاندن، ١٤٠، ٢٢٠، ٣٢) }
  ئەگەر دروستکراو >= ٦٠ و نۆتەکان.درێژی == ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٣٦٠، ٤٤٠)
    ڕەنگبکە("سپی")
    نووسین("تەواو بوو!", ١١٠، ١٦٠، ٣٢)
    نووسین("خاڵ: " + خاڵ، ١٢٠، ٢٠٠، ٢٤)
    نووسین("باشترین کۆمبۆ: " + باشترین_کۆمبۆ، ٩٠، ٢٣٠، ٢٠)
    نووسین("کلیک = دووبارە", ١٠٠، ٢٧٠، ٢٠)
  }
})
