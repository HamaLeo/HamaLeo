// 🔢 کاتژمێری دووانی — کاتی ڕاستەقینە بە لامپی دووانی (١ = لامپ ڕووناک). هەر ستوونێک ژمارەیەکە: سەعات، خولەک، چرکە
قەبارە(٤٢٠، ٢٨٠)
کار ژمارە_ستوون(x، ژمارە، ڕەنگ، ناو) {
  بۆ بیت لە ٠ تا ٥ {
    نەگۆڕ ڕووناکە = خوارکە(ژمارە / توان(٢، بیت)) % ٢ == ١
    ڕەنگبکە(ڕووناکە ? ڕەنگ : ڕەنگی(٣٠، ٣٥، ٥٥))
    بازنە(x، ٢٢٠ - بیت * ٣٠، ١٠)
    ئەگەر ڕووناکە { ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٤))؛ بازنە(x - ٣، ٢١٦ - بیت * ٣٠، ٣) }
  }
  ڕەنگبکە("سپی")
  نووسین(ناو، x - ١٥، ٢٥٠، ١٦)
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٦))
  نووسین(ژمارە، x - ٩، ٢٧٢، ١٤)
}
یاریبکە(() => {
  نەگۆڕ ک = ئێستا()
  پاشبنەمابکە(ڕەنگی(١٥، ١٨، ٣٥))
  ڕەنگبکە("سپی")
  نووسین(ک.سەعات + ":" + (ک.خولەک < ١٠ ? "٠" : "") + ک.خولەک + ":" + (ک.چرکە < ١٠ ? "٠" : "") + ک.چرکە، ١٤٠، ٣٥، ٣٠)
  ژمارە_ستوون(٨٠، ک.سەعات، "سوور", "سەعات")
  ژمارە_ستوون(٢١٠، ک.خولەک، "سەوز", "خولەک")
  ژمارە_ستوون(٣٤٠، ک.چرکە، "ئاسمانی", "چرکە")
})
