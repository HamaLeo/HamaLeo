// یاری: خێرایی کاردانەوە ⚡ — کاتێک شاشە سەوز بوو، یەکسەر کلیک بکە! زوو کلیک بکەیت (پێش سەوزبوون) دەدۆڕێت
قەبارە(٤٠٠، ٢٨٠)
گۆڕاو دۆخ = "ئامادە"           // ئامادە، چاوەڕێ، ئێستا، زوو، ئەنجام
گۆڕاو کات = ٠
گۆڕاو ئامانج = ٠
گۆڕاو کاردانەوە = ٠
گۆڕاو باشترین = ٠
گۆڕاو هەوڵەکان = []

یاریبکە(() => {
  کات += ١
  ئەگەر کلیککراوە() {
    ئەگەر دۆخ == "ئامادە" یان دۆخ == "ئەنجام" یان دۆخ == "زوو" {
      دۆخ = "چاوەڕێ"؛ کات = ٠؛ ئامانج = هەڕەمەکی( 6٠، ١٨٠)
    } ئەگەرنا ئەگەر دۆخ == "چاوەڕێ" {
      دۆخ = "زوو"
    } ئەگەرنا ئەگەر دۆخ == "ئێستا" {
      کاردانەوە = خوارکە(کات * ١٦٫٧)
      هەوڵەکان.زیادبکە(کاردانەوە)
      ئەگەر باشترین == ٠ یان کاردانەوە < باشترین { باشترین = کاردانەوە }
      دۆخ = "ئەنجام"
    }
  }
  ئەگەر دۆخ == "چاوەڕێ" و کات >= ئامانج { دۆخ = "ئێستا"؛ کات = ٠ }

  پاشبنەمابکە(دۆخ == "ئێستا" ? ڕەنگی(٣٠، ١٨٠، ٨٠) : دۆخ == "چاوەڕێ" ? ڕەنگی(٢٠٠، ٥٠، ٥٠) : دۆخ == "زوو" ? ڕەنگی(٢٢٠، ١٣٠، ٣٠) : ڕەنگی(٣٠، ٥٠، ١٠٠))
  ڕەنگبکە("سپی")
  ئەگەر دۆخ == "ئامادە" { نووسین("کلیک بکە بۆ دەستپێک", ٩٠، ١٣٥، ٢٨) }
  ئەگەر دۆخ == "چاوەڕێ" { نووسین("چاوەڕێ بکە... (سوور)", ٨٠، ١٣٥، ٢٨) }
  ئەگەر دۆخ == "ئێستا" { نووسین("ئێستا کلیک بکە!", ٩٠، ١٣٥، ٣٢) }
  ئەگەر دۆخ == "زوو" { نووسین("زۆر زوو بوو! کلیک = دووبارە", ٥٠، ١٣٥، ٢٦) }
  ئەگەر دۆخ == "ئەنجام" {
    نووسین(کاردانەوە + " ms", ١٣٠، ١٢٠، ٤٨)
    نووسین("کلیک = دووبارە", ١٤٠، ١٧٠، ٢٠)
  }
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٧))
  ئەگەر باشترین > ٠ { نووسین("باشترین: " + باشترین + " ms", ١٠، ٢٦٠، ١٨) }
  نووسین("هەوڵ: " + هەوڵەکان.درێژی، ٣٢٠، ٢٦٠، ١٨)
})
