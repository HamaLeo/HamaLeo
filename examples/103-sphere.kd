// 🌐 گۆی ٣D — ٣٠٠ نوختە بە شێوەی گۆیەک دەسووڕێن: ئەوانەی نزیکترن گەورەتر و ڕووناکترن (قووڵایی). ماوس = گۆڕینی ئاڕاستە
قەبارە(٣٦٠، ٣٦٠)
نەگۆڕ نوختەکان = []
بۆ i لە ٠ تا ٣٠٠ {
  نەگۆڕ y = ١ - (i / ١٥٠)           // لە ١ بۆ -١
  نەگۆڕ r = ڕەگ(گەورەترین(٠، ١ - y * y))
  نەگۆڕ گ = i * ٢٫٣٩٩٩٦٣           // گۆشەی زێڕین
  نوختەکان.زیادبکە({ x: کۆسینۆس(گ) * r، y: y، z: سینۆس(گ) * r })
}
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠٢
  نەگۆڕ لار = ماوسY() >= ٠ ? (ماوسY() - ١٨٠) / ٣٠٠ : ٠٫٣
  پاشبنەمابکە(ڕەنگی(٨، ١٠، ٢٥))
  نەگۆڕ پرۆجەکت = نوختەکان.نەخشە(ن => {
    نەگۆڕ x١ = ن.x * کۆسینۆس(کات) + ن.z * سینۆس(کات)
    نەگۆڕ z١ = -ن.x * سینۆس(کات) + ن.z * کۆسینۆس(کات)
    نەگۆڕ y٢ = ن.y * کۆسینۆس(لار) - z١ * سینۆس(لار)
    نەگۆڕ z٢ = ن.y * سینۆس(لار) + z١ * کۆسینۆس(لار)
    گەڕێنەوە { x: ١٨٠ + x١ * ١٣٠، y: ١٨٠ + y٢ * ١٣٠، z: z٢ }
  })
  پرۆجەکت.ڕیزبکە((a، b) => b.z - a.z)
  بۆ هەر ن لە پرۆجەکت {
    نەگۆڕ گەشی = (٠٫٥ - ن.z * ٠٫٥)
    ڕەنگبکە(ڕەنگی(٨٠ + ١٦٠ * گەشی، ١٥٠ + ١٠٠ * گەشی، ٢٥٥، ٠٫٣ + ٠٫٧ * گەشی))
    بازنە(ن.x، ن.y، ١٫٥ + ٢٫٥ * گەشی)
  }
})
