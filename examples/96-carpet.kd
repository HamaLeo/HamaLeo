// ⬛ مەفرەشی سێرپینسکی — لاکێشێک کە ٩ بەش دەکرێت و ناوەڕاستەکەی دەسڕدرێتەوە، بە Recursion. (ئاستی ٤ = ٤٠٩٦ لاکێش)
قەبارە(٣٦٠، ٣٦٠)
پاشبنەمابکە(ڕەنگی(١٥، ٢٠، ٤٥))

کار مەفرەش(x، y، قەبارە، ئاست) {
  ئەگەر ئاست == ٠ {
    ڕەنگبکە(پەلکەزێڕینە(x + y))
    لاکێش(x، y، قەبارە، قەبارە)
    گەڕێنەوە
  }
  نەگۆڕ ت = قەبارە / ٣
  بۆ ڕ لە ٠ تا ٢ {
    بۆ س لە ٠ تا ٢ {
      ئەگەر نەک (ڕ == ١ و س == ١) { مەفرەش(x + س * ت، y + ڕ * ت، ت، ئاست - ١) }
    }
  }
}
مەفرەش(٢٠، ٢٠، ٣٢٤، ٤)
