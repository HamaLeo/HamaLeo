// یاری: ڕاکردن لە تۆپە سوورەکان 🔴 — بە ماوس بازنەکەت بجووڵێنە و تا دەتوانیت بمێنەوە! هەر ٥ چرکە تۆپێکی نوێ دێت
قەبارە(٤٠٠، ٤٠٠)
گۆڕاو x = ٢٠٠
گۆڕاو y = ٢٠٠
گۆڕاو تۆپەکان = []
گۆڕاو کات = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو بەرزترین = ٠

کار دووبارە() {
  x = ٢٠٠؛ y = ٢٠٠؛ کات = ٠؛ مردووە = هەڵە
  تۆپەکان = []
  بۆ i لە ١ تا ٣ { تۆپی_نوێ() }
}
کار تۆپی_نوێ() {
  نەگۆڕ گ = هەڕەمەکی(٠، ٣٦٠) * پای / ١٨٠
  نەگۆڕ لێوار = هەڕەمەکی(٠، ٣)
  تۆپەکان.زیادبکە({ x: لێوار == ٠ ? ١٥ : لێوار == ١ ? ٣٨٥ : هەڕەمەکی(٢٠، ٣٨٠)، y: لێوار == ٢ ? ١٥ : لێوار == ٣ ? ٣٨٥ : هەڕەمەکی(٢٠، ٣٨٠)، vx: کۆسینۆس(گ) * (٢ + هەڕەمەکی(٠، ٢)) ، vy: سینۆس(گ) * (٢ + هەڕەمەکی(٠، ٢)) })
}
دووبارە()

یاریبکە(() => {
  ئەگەر نەک مردووە {
    کات += ١
    ئەگەر ماوسX() >= ٠ { x += (ماوسX() - x) * ٠٫٢؛ y += (ماوسY() - y) * ٠٫٢ }
    ئەگەر کات % ٣٠٠ == ٠ { تۆپی_نوێ() }
    بۆ هەر ت لە تۆپەکان {
      ت.x += ت.vx؛ ت.y += ت.vy
      ئەگەر ت.x < ١٢ یان ت.x > ٣٨٨ { ت.vx = -ت.vx؛ ت.x = سنوور(ت.x، ١٢، ٣٨٨) }
      ئەگەر ت.y < ١٢ یان ت.y > ٣٨٨ { ت.vy = -ت.vy؛ ت.y = سنوور(ت.y، ١٢، ٣٨٨) }
      ئەگەر دووری(x، y، ت.x، ت.y) < ٢٠ { مردووە = ڕاست }
    }
    بەرزترین = گەورەترین(بەرزترین، خوارکە(کات / ٦٠))
  } ئەگەرنا ئەگەر کلیککراوە() { دووبارە() }

  پاشبنەمابکە(ڕەنگی(١٥، ١٨، ٣٥))
  ڕەنگبکە(ڕەنگی(٢٠، ٢٥، ٤٥))
  بۆ i لە ٠ تا ٧ { لاکێش(i * ٥٠ + ٢٥، ٠، ٢٥، ٤٠٠) }
  بۆ هەر ت لە تۆپەکان {
    ڕەنگبکە(ڕەنگی(٢٢٠، ٦٠، ٦٠))
    بازنە(ت.x، ت.y، ١٢)
    ڕەنگبکە(ڕەنگی(٢٥٥، ١٥٠، ١٥٠، ٠٫٦))
    بازنە(ت.x - ٤، ت.y - ٤، ٤)
  }
  ڕەنگبکە("ئاسمانی")
  بازنە(x، y، ٨)
  ڕەنگبکە("سپی")
  نووسین("کات: " + خوارکە(کات / ٦٠) + " چرکە", ١٠، ٢٥، ٢٠)
  نووسین("باشترین: " + بەرزترین، ٢٩٠، ٢٥، ١٨)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٤٠٠، ٤٠٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! " + خوارکە(کات / ٦٠) + " چرکە", ١٠٠، ١٩٠، ٣٠)
    نووسین("کلیک = دووبارە", ١٤٠، ٢٣٠، ٢٠)
  }
})
