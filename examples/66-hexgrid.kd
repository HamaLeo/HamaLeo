// ⬡ تۆڕی شەشگۆشە — شەپۆلێکی ڕەنگاوڕەنگ بە سەر شەشگۆشەکاندا دەڕوات. ماوس بجووڵێنە بۆ شوێنی سەرچاوەی شەپۆل
قەبارە(٤٥٠، ٣٢٠)
گۆڕاو کات = ٠
نەگۆڕ r = ٢٢

کار شەشگۆشە(cx، cy، قەبارە) {
  بۆ i لە ٠ تا ٥ {
    نەگۆڕ a١ = i * پای / ٣
    نەگۆڕ a٢ = (i + ١) * پای / ٣
    سێگۆشە(cx، cy، cx + کۆسینۆس(a١) * قەبارە، cy + سینۆس(a١) * قەبارە، cx + کۆسینۆس(a٢) * قەبارە، cy + سینۆس(a٢) * قەبارە)
  }
}

یاریبکە(() => {
  کات += ٠٫٠٦
  نەگۆڕ سەرچاوەx = ماوسX() >= ٠ ? ماوسX() : ٢٢٥
  نەگۆڕ سەرچاوەy = ماوسY() >= ٠ ? ماوسY() : ١٦٠
  پاشبنەمابکە(ڕەنگی(١٠، ١٠، ٢٥))
  بۆ ڕ لە ٠ تا ١٠ {
    بۆ س لە ٠ تا ١٣ {
      نەگۆڕ cx = س * r * ١٫٧٣٢ + (ڕ % ٢) * r * ٠٫٨٦٦ + ١٠
      نەگۆڕ cy = ڕ * r * ١٫٥ + ١٥
      نەگۆڕ d = دووری(cx، cy، سەرچاوەx، سەرچاوەy)
      نەگۆڕ شەپۆل = سینۆس(d / ٢٥ - کات * ٣)
      ڕەنگبکە(پەلکەزێڕینە(d * ٠٫٨ + کات * ٣٠، ٠٫٥ + ٠٫٤ * شەپۆل))
      شەشگۆشە(cx، cy، r * ٠٫٩٢ * (٠٫٦ + ٠٫٤ * (شەپۆل + ١) / ٢))
    }
  }
})
