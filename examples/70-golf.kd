// یاری: گۆڵف ⛳ — ماوس لەسەر تۆپەکە دابگرە، دواوە بکێشە و بەریبدە. تۆپەکە بخەرە ناو کونە ڕەشەکە بە کەمترین لێدان! (٣ قۆناغ)
قەبارە(٥٠٠، ٣٢٠)
نەگۆڕ قۆناغەکان = [
  { تۆپ: [٧٠، ١٦٠]، کون: [٤٢٠، ١٦٠]، ڕێگر: [] }،
  { تۆپ: [٧٠، ٨٠]، کون: [٤٢٠، ٢٥٠]، ڕێگر: [[٢٣٠، ٥٠، ٢٠، ١٦٠]] }،
  { تۆپ: [٧٠، ٢٦٠]، کون: [٤٢٠، ٧٠]، ڕێگر: [[١٨٠، ٠، ٢٠، ١٦٠]، [٣١٠، ١٨٠، ٢٠، ١٤٠]] }،
]
گۆڕاو قۆناغ = ٠
گۆڕاو x = ٧٠
گۆڕاو y = ١٦٠
گۆڕاو vx = ٠
گۆڕاو vy = ٠
گۆڕاو کێشان = هەڵە
گۆڕاو لێدان = ٠
گۆڕاو کۆی = ٠
گۆڕاو تەواو = هەڵە

کار بارکردن(ق) {
  x = قۆناغەکان[ق].تۆپ[٠]؛ y = قۆناغەکان[ق].تۆپ[١]؛ vx = ٠؛ vy = ٠؛ لێدان = ٠؛ تەواو = هەڵە
}
بارکردن(٠)

یاریبکە(() => {
  نەگۆڕ ق = قۆناغەکان[قۆناغ]
  نەگۆڕ خێرایی = دووری(٠، ٠، vx، vy)
  ئەگەر نەک تەواو {
    ئەگەر خێرایی < ٠٫٢ {
      vx = ٠؛ vy = ٠
      ئەگەر ماوسگیراوە() و نەک کێشان و دووری(ماوسX()، ماوسY()، x، y) < ٣٠ { کێشان = ڕاست }
      ئەگەر کێشان و نەک ماوسگیراوە() {
        نەگۆڕ d = دووری(ماوسX()، ماوسY()، x، y)
        نەگۆڕ هێز = بچووکترین(d، ١٢٠) * ٠٫١٥
        ئەگەر d > ٣ { vx = (x - ماوسX()) / d * هێز؛ vy = (y - ماوسY()) / d * هێز؛ لێدان += ١ }
        کێشان = هەڵە
      }
    }
    x += vx؛ y += vy
    vx *= ٠٫٩٨٦؛ vy *= ٠٫٩٨٦
    ئەگەر x < ٩ { x = ٩؛ vx = -vx }
    ئەگەر x > ٤٩١ { x = ٤٩١؛ vx = -vx }
    ئەگەر y < ٩ { y = ٩؛ vy = -vy }
    ئەگەر y > ٣١١ { y = ٣١١؛ vy = -vy }
    بۆ هەر ڕ لە ق.ڕێگر {
      نەگۆڕ نx = سنوور(x، ڕ[٠]، ڕ[٠] + ڕ[٢])
      نەگۆڕ نy = سنوور(y، ڕ[١]، ڕ[١] + ڕ[٣])
      ئەگەر دووری(x، y، نx، نy) < ٩ {
        ئەگەر ڕەها(x - نx) > ڕەها(y - نy) { vx = -vx؛ x += vx * ٢ } ئەگەرنا { vy = -vy؛ y += vy * ٢ }
      }
    }
    ئەگەر دووری(x، y، ق.کون[٠]، ق.کون[١]) < ١٤ و خێرایی < ٥ { تەواو = ڕاست؛ کۆی += لێدان }
  } ئەگەرنا ئەگەر کلیککراوە() {
    ئەگەر قۆناغ == قۆناغەکان.درێژی - ١ { قۆناغ = ٠؛ کۆی = ٠ } ئەگەرنا { قۆناغ += ١ }
    بارکردن(قۆناغ)
  }

  پاشبنەمابکە(ڕەنگی(٤٠، ١٣٠، ٦٠))
  ڕەنگبکە(ڕەنگی(٣٥، ١١٥، ٥٠))
  بۆ i لە ٠ تا ١٢ { لاکێش(i * ٤٠، ٠، ٢٠، ٣٢٠) }
  ڕەنگبکە("ڕەش")
  بازنە(ق.کون[٠]، ق.کون[١]، ١٤)
  ڕەنگبکە("سپی")
  لاکێش(ق.کون[٠]، ق.کون[١] - ٤٠، ٢، ٤٠)
  ڕەنگبکە("سوور")
  سێگۆشە(ق.کون[٠] + ٢، ق.کون[١] - ٤٠، ق.کون[٠] + ٢٢، ق.کون[١] - ٣٤، ق.کون[٠] + ٢، ق.کون[١] - ٢٨)
  ڕەنگبکە(ڕەنگی(١٣٠، ٩٠، ٥٠))
  بۆ هەر ڕ لە ق.ڕێگر { لاکێش(ڕ[٠]، ڕ[١]، ڕ[٢]، ڕ[٣]) }
  ئەگەر کێشان {
    هێڵڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٨))
    ئەستووریبکە(٢)
    نەگۆڕ d = بچووکترین(دووری(ماوسX()، ماوسY()، x، y)، ١٢٠)
    نەگۆڕ ئا = دووری(ماوسX()، ماوسY()، x، y) > ٠ ? ١ / دووری(ماوسX()، ماوسY()، x، y) : ٠
    هێڵ(x، y، x + (x - ماوسX()) * ئا * d، y + (y - ماوسY()) * ئا * d)
    هێڵ(x، y، x - (x - ماوسX()) * ئا * d * ٠٫٣، y - (y - ماوسY()) * ئا * d * ٠٫٣)
  }
  ڕەنگبکە("سپی")
  بازنە(x، y، ٨)
  ڕەنگبکە("سپی")
  نووسین("قۆناغ " + (قۆناغ + ١) + "   لێدان: " + لێدان، ١٠، ٢٥، ٢٠)
  ئەگەر تەواو { نووسین("⛳ لە کونەکە! لێدان: " + لێدان + (قۆناغ == قۆناغەکان.درێژی - ١ ? "   کۆی: " + کۆی : "") + " — کلیک", ٦٠، ٣٠٥، ٢٠) }
})
