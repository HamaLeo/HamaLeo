// یاری: باڵندە توڕەکان 🐦 — باڵندەکە لە کەوانەی چەپ ڕابکێشە (ماوس دابگرە، دواوە بکێشە، بەریبدە) و بەسەر بەرازە سەوزەکاندا بیکەوێنە!
قەبارە(٥٠٠، ٣٢٠)
نەگۆڕ دۆخی_کەوان = [٨٠، ٢١٠]
نەگۆڕ بلۆکەکان = [[٣٣٠، ٢٣٥، ١٥، ٦٠]، [٣٨٠، ٢٠٠، ٨٠، ١٢]]
گۆڕاو بەرازەکان = []
گۆڕاو x = ٨٠
گۆڕاو y = ٢١٠
گۆڕاو vx = ٠
گۆڕاو vy = ٠
گۆڕاو فڕیوە = هەڵە
گۆڕاو کێشان = هەڵە
گۆڕاو باڵندەکان = ٣
گۆڕاو چاوەڕێ = ٠

کار دەستپێکردن() {
  بەرازەکان = [{ x: ٤٠٠، y: ٢٧٠، مردووە: هەڵە }، { x: ٤٢٠، y: ١٨٥، مردووە: هەڵە }، { x: ٤٨٠، y: ٢٧٠، مردووە: هەڵە }]
  باڵندەکان = ٣
  نوێکردنەوەی_باڵندە()
}
کار نوێکردنەوەی_باڵندە() { x = ٨٠؛ y = ٢١٠؛ vx = ٠؛ vy = ٠؛ فڕیوە = هەڵە؛ کێشان = هەڵە؛ چاوەڕێ = ٠ }
دەستپێکردن()

یاریبکە(() => {
  نەگۆڕ ماوە = بەرازەکان.پاڵاوتن(ب => نەک ب.مردووە).درێژی
  ئەگەر ماوە > ٠ و (باڵندەکان > ٠ یان فڕیوە) {
    ئەگەر نەک فڕیوە {
      ئەگەر ماوسگیراوە() و نەک کێشان و دووری(ماوسX()، ماوسY()، x، y) < ٣٥ { کێشان = ڕاست }
      ئەگەر کێشان {
        ئەگەر ماوسگیراوە() {
          نەگۆڕ d = بچووکترین(دووری(ماوسX()، ماوسY()، دۆخی_کەوان[٠]، دۆخی_کەوان[١])، ٨٠)
          نەگۆڕ بەدوور = گەورەترین(دووری(ماوسX()، ماوسY()، دۆخی_کەوان[٠]، دۆخی_کەوان[١])، ١)
          x = دۆخی_کەوان[٠] + (ماوسX() - دۆخی_کەوان[٠]) / بەدوور * d
          y = دۆخی_کەوان[١] + (ماوسY() - دۆخی_کەوان[١]) / بەدوور * d
        } ئەگەرنا {
          vx = (دۆخی_کەوان[٠] - x) * ٠٫٢٥
          vy = (دۆخی_کەوان[١] - y) * ٠٫٢٥
          فڕیوە = ڕاست؛ کێشان = هەڵە؛ باڵندەکان -= ١؛ چاوەڕێ = ٠
        }
      }
    } ئەگەرنا {
      vy += ٠٫٢
      x += vx؛ y += vy
      چاوەڕێ += ١
      ئەگەر y > ٢٨٥ { y = ٢٨٥؛ vy = -vy * ٠٫٤؛ vx *= ٠٫٨ }
      بۆ هەر ب لە بلۆکەکان {
        نەگۆڕ نx = سنوور(x، ب[٠]، ب[٠] + ب[٢])
        نەگۆڕ نy = سنوور(y، ب[١]، ب[١] + ب[٣])
        ئەگەر دووری(x، y، نx، نy) < ١٠ {
          ئەگەر ڕەها(x - نx) > ڕەها(y - نy) { vx = -vx * ٠٫٥؛ x += vx * ٢ } ئەگەرنا { vy = -vy * ٠٫٥؛ y += vy * ٢ }
        }
      }
      بۆ هەر ب لە بەرازەکان {
        ئەگەر نەک ب.مردووە و دووری(x، y، ب.x، ب.y) < ٢٢ { ب.مردووە = ڕاست؛ vx *= ٠٫٧ }
      }
      ئەگەر x > ٥٢٠ یان (دووری(٠، ٠، vx، vy) < ٠٫٣ و چاوەڕێ > ٦٠) یان چاوەڕێ > ٣٠٠ { نوێکردنەوەی_باڵندە() }
    }
  } ئەگەرنا ئەگەر کلیککراوە() { دەستپێکردن() }

  پاشبنەمابکە(ڕەنگی(١٣٥، ٢٠٦، ٢٣٥))
  ڕەنگبکە(ڕەنگی(٩٠، ١٦٠، ٧٠))
  لاکێش(٠، ٢٩٥، ٥٠٠، ٣٠)
  ڕەنگبکە(ڕەنگی(١٣٠، ٩٠، ٥٠))
  لاکێش(دۆخی_کەوان[٠] - ٤، دۆخی_کەوان[١]، ٨، ٨٥)
  هێڵڕەنگبکە(ڕەنگی(٨٠، ٥٠، ٣٠))
  ئەستووریبکە(٣)
  ئەگەر کێشان { هێڵ(دۆخی_کەوان[٠] - ٦، دۆخی_کەوان[١]، x، y)؛ هێڵ(دۆخی_کەوان[٠] + ٦، دۆخی_کەوان[١]، x، y) }
  ڕەنگبکە(ڕەنگی(١٥٠، ١٠٠، ٥٠))
  بۆ هەر ب لە بلۆکەکان { لاکێش(ب[٠]، ب[١]، ب[٢]، ب[٣]) }
  بۆ هەر ب لە بەرازەکان {
    ئەگەر نەک ب.مردووە {
      ڕەنگبکە("سەوز")
      بازنە(ب.x، ب.y، ١٥)
      ڕەنگبکە("سپی")
      بازنە(ب.x - ٥، ب.y - ٣، ٤)؛ بازنە(ب.x + ٥، ب.y - ٣، ٤)
      ڕەنگبکە("ڕەش")
      بازنە(ب.x - ٥، ب.y - ٣، ٢)؛ بازنە(ب.x + ٥، ب.y - ٣، ٢)
    }
  }
  ڕەنگبکە("سوور")
  بازنە(x، y، ١٠)
  ڕەنگبکە("سپی")
  بازنە(x + ٣، y - ٢، ٣)
  ڕەنگبکە("ڕەش")
  نووسین("باڵندە: " + گەورەترین(باڵندەکان، ٠)، ١٠، ٢٥، ٢٠)
  ئەگەر ماوە == ٠ { نووسین("🎉 هەموو بەرازەکان! کلیک = دووبارە", ١٠٠، ١٠٠، ٢٦) }
  ئەگەر ماوە > ٠ و باڵندەکان == ٠ و نەک فڕیوە { نووسین("باڵندەت نەما! کلیک = دووبارە", ١٢٠، ١٠٠، ٢٤) }
})
