// یاری: وەرگێڕانی کێشکردن 🔄 — بۆشایی یان کلیک کێشکردن دەگۆڕێت (زەوی ↔ سەقف). لە درکەکان ڕابکە و سکەکان کۆبکەرەوە!
قەبارە(٥٠٠، ٢٤٠)
گۆڕاو y = ٢٠٠
گۆڕاو vy = ٠
گۆڕاو کێشکردن = ١         // ١ = خوارەوە، -١ = سەرەوە
گۆڕاو بەربەستەکان = []
گۆڕاو خێرایی = ٥
گۆڕاو خاڵ = ٠
گۆڕاو مەودا = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو کات = ٠
گۆڕاو پێشوو = هەڵە

کار دووبارە() { y = ٢٠٠؛ vy = ٠؛ کێشکردن = ١؛ بەربەستەکان = []؛ خێرایی = ٥؛ خاڵ = ٠؛ مەودا = ٠؛ مردووە = هەڵە }

یاریبکە(() => {
  کات += ١
  نەگۆڕ دابگیراوە = کلیل("بۆشایی") یان ماوسگیراوە()
  ئەگەر مردووە {
    ئەگەر کلیککراوە() { دووبارە() }
  } ئەگەرنا {
    ئەگەر دابگیراوە و نەک پێشوو { کێشکردن = -کێشکردن }
    vy += کێشکردن * ٠٫٧
    vy = سنوور(vy، -٨، ٨)
    y += vy
    ئەگەر y > ٢٠٠ { y = ٢٠٠؛ vy = ٠ }
    ئەگەر y < ٢٠ { y = ٢٠؛ vy = ٠ }
    مەودا += خێرایی
    خێرایی = ٥ + مەودا / ٢٠٠٠
    ئەگەر کات % خوارکە(٦٥ - بچووکترین(٣٥، مەودا / ٦٠٠)) == ٠ {
      نەگۆڕ جۆر = هەڕەمەکی(٠، ٣)
      بەربەستەکان.زیادبکە({ x: ٥٣٠، لەخوارەوە: هەڕەمەکی(٠، ١) == ٠، سکە: جۆر == ٣ })
    }
    بۆ هەر ب لە بەربەستەکان {
      ب.x -= خێرایی
      نەگۆڕ بy = ب.لەخوارەوە ? ٢٢٠ : ٢٠
      ئەگەر ب.x > ٦٠ و ب.x < ١٢٠ و ڕەها(y - بy) < (ب.سکە ? ٢٨ : ٢٤) و نەک ب.گیرا {
        ئەگەر ب.سکە { ب.گیرا = ڕاست؛ خاڵ += ١٠ } ئەگەرنا { مردووە = ڕاست }
      }
    }
    بەربەستەکان = بەربەستەکان.پاڵاوتن(ب => ب.x > -٥٠ و نەک ب.گیرا)
  }
  پێشوو = دابگیراوە

  پاشبنەمابکە(ڕەنگی(٢٠، ١٥، ٤٠))
  ڕەنگبکە(ڕەنگی(٤٠، ٣٠، ٨٠))
  لاکێش(٠، ٢٢٠، ٥٠٠، ٢٠)
  لاکێش(٠، ٠، ٥٠٠، ٢٠)
  ڕەنگبکە(ڕەنگی(٨٠، ٦٠، ١٣٠))
  بۆ i لە ٠ تا ٩ { لاکێش(((i * ٦٠ - مەودا) % ٦٠٠ + ٦٠٠) % ٦٠٠ - ٥٠، ٢١٥، ٣٠، ٥)؛ لاکێش(((i * ٦٠ - مەودا) % ٦٠٠ + ٦٠٠) % ٦٠٠ - ٥٠، ٢٠، ٣٠، ٥) }
  بۆ هەر ب لە بەربەستەکان {
    ئەگەر ب.سکە {
      ڕەنگبکە("زەرد")
      بازنە(ب.x + ٢٠، ب.لەخوارەوە ? ١٨٠ : ٦٠، ١٠)
    } ئەگەرنا {
      ڕەنگبکە("سوور")
      ئەگەر ب.لەخوارەوە { سێگۆشە(ب.x، ٢٢٠، ب.x + ٤٠، ٢٢٠، ب.x + ٢٠، ١٨٠) } ئەگەرنا { سێگۆشە(ب.x، ٢٠، ب.x + ٤٠، ٢٠، ب.x + ٢٠، ٦٠) }
    }
  }
  ڕەنگبکە("ئاسمانی")
  لاکێش(٧٠، y - ١٠، ٢٠، ٢٠)
  ڕەنگبکە("سپی")
  بازنە(٨٢، y - (کێشکردن > ٠ ? ٣ : -٣)، ٣)
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ + "   مەودا: " + خوارکە(مەودا / ١٠)، ١٠، ١٦، ١٤)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٥٠٠، ٢٤٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! " + (خاڵ + خوارکە(مەودا / ١٠)) + " خاڵ", ١٧٠، ١٠٠، ٢٨)
    نووسین("کلیک = دووبارە", ٢٠٠، ١٤٠، ٢٠)
  }
})
