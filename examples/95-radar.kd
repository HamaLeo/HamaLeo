// 📡 ڕادار — هێڵێکی سەوز دەسووڕێتەوە و ئامانجەکان کاتێک دەیگاتن ڕووناک دەبنەوە و هێواش کاڵ دەبنەوە. کلیک = ئامانجی نوێ
قەبارە(٣٦٠، ٣٦٠)
گۆڕاو ئامانجەکان = []
گۆڕاو گۆشە = ٠
بۆ i لە ١ تا ٨ { ئامانجەکان.زیادبکە({ g: هەڕەمەکی(٠، ٣٥٩) * پای / ١٨٠، d: هەڕەمەکی(٣٠، ١٦٠)، گەشی: ٠ }) }

// گۆشەی خاڵێک (atan2 بەردەست نییە، بۆیە لە ٣٦٠ پلە باشترینی دەدۆزینەوە)
کار گۆشەی(dx، dy) {
  نەگۆڕ d = گەورەترین(دووری(٠، ٠، dx، dy)، ٠٫٠٠١)
  گۆڕاو باشترین = ١٠٠٠
  گۆڕاو a = ٠
  بۆ k لە ٠ تا ٣٥٩ {
    نەگۆڕ g = k * پای / ١٨٠
    نەگۆڕ جیاوازی = دووری(کۆسینۆس(g)، سینۆس(g)، dx / d، dy / d)
    ئەگەر جیاوازی < باشترین { باشترین = جیاوازی؛ a = g }
  }
  گەڕێنەوە a
}

یاریبکە(() => {
  گۆشە = (گۆشە + ٠٫٠٤) % (٢ * پای)
  ئەگەر کلیککراوە() {
    ئامانجەکان.زیادبکە({ g: گۆشەی(ماوسX() - ١٨٠، ماوسY() - ١٨٠)، d: دووری(٠، ٠، ماوسX() - ١٨٠، ماوسY() - ١٨٠)، گەشی: ٠ })
  }
  پاشبنەمابکە(ڕەنگی(٥، ١٥، ١٠))
  هێڵڕەنگبکە(ڕەنگی(٢٠، ١٠٠، ٥٠))
  ئەستووریبکە(١)
  بۆ i لە ١ تا ٤ { بازنەهێڵ(١٨٠، ١٨٠، i * ٤٥) }
  هێڵ(٢٠، ١٨٠، ٣٤٠، ١٨٠)؛ هێڵ(١٨٠، ٢٠، ١٨٠، ٣٤٠)
  بۆ i لە ٣٠ تا ٠ هەنگاو -١ {
    ڕەنگبکە(ڕەنگی(٣٠، ٢٢٠، ٨٠، ٠٫٠٦ * (٣٠ - i) / ٣٠))
    سێگۆشە(١٨٠، ١٨٠، ١٨٠ + کۆسینۆس(گۆشە - i * ٠٫٠٢) * ١٨٠، ١٨٠ + سینۆس(گۆشە - i * ٠٫٠٢) * ١٨٠، ١٨٠ + کۆسینۆس(گۆشە - (i + ١) * ٠٫٠٢) * ١٨٠، ١٨٠ + سینۆس(گۆشە - (i + ١) * ٠٫٠٢) * ١٨٠)
  }
  هێڵڕەنگبکە(ڕەنگی(٨٠، ٢٥٥، ١٢٠))
  ئەستووریبکە(٢)
  هێڵ(١٨٠، ١٨٠، ١٨٠ + کۆسینۆس(گۆشە) * ١٨٠، ١٨٠ + سینۆس(گۆشە) * ١٨٠)
  بۆ هەر ئ لە ئامانجەکان {
    نەگۆڕ جیاوازی = (((گۆشە - ئ.g) % (٢ * پای)) + ٢ * پای) % (٢ * پای)
    ئەگەر جیاوازی < ٠٫٠٤ { ئ.گەشی = ١ }
    ئ.گەشی = گەورەترین(٠، ئ.گەشی - ٠٫٠٠٦)
    ڕەنگبکە(ڕەنگی(٨٠، ٢٥٥، ١٢٠، ئ.گەشی))
    بازنە(١٨٠ + کۆسینۆس(ئ.g) * ئ.d، ١٨٠ + سینۆس(ئ.g) * ئ.d، ٥)
  }
})
