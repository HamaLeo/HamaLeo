// 🌊 مەیدانی ڕەوان — ٢٠٠ زەرەی بچووک لەسەر ڕێڕەوی نەزانراو دەڕۆن، ئاڕاستەیان لە سینۆسەوە دیاری دەکرێت. ماوس = گۆڕینی مەیدان
قەبارە(٤٥٠، ٣٢٠)
نەگۆڕ زەرەکان = []
بۆ i لە ١ تا ٢٠٠ { زەرەکان.زیادبکە({ x: هەڕەمەکی(٠، ٤٥٠)، y: هەڕەمەکی(٠، ٣٢٠)، ڕێ: [] }) }
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠١
  نەگۆڕ مەودا = ماوسX() >= ٠ ? ماوسX() / ٣٠٠٠ + ٠٫٠٠٥ : ٠٫٠١
  پاشبنەمابکە(ڕەنگی(١٠، ١٢، ٣٠))
  ئەستووریبکە(١٫٥)
  بۆ هەر ز لە زەرەکان {
    نەگۆڕ گ = (سینۆس(ز.x * مەودا + کات) + کۆسینۆس(ز.y * مەودا * ١٫٣ - کات)) * پای
    ز.x += کۆسینۆس(گ) * ١٫٦؛ ز.y += سینۆس(گ) * ١٫٦
    ز.ڕێ.زیادبکە({ x: ز.x، y: ز.y })
    ئەگەر ز.ڕێ.درێژی > ١٤ { ز.ڕێ.یەکەمیلابەرە() }
    ئەگەر ز.x < ٠ یان ز.x > ٤٥٠ یان ز.y < ٠ یان ز.y > ٣٢٠ { ز.x = هەڕەمەکی(٠، ٤٥٠)؛ ز.y = هەڕەمەکی(٠، ٣٢٠)؛ ز.ڕێ = [] }
    بۆ i لە ١ تا ز.ڕێ.درێژی - ١ {
      هێڵڕەنگبکە(پەلکەزێڕینە(گ * ٣٠ + ٢٠٠، i / ١٤))
      هێڵ(ز.ڕێ[i - ١].x، ز.ڕێ[i - ١].y، ز.ڕێ[i].x، ز.ڕێ[i].y)
    }
  }
})
