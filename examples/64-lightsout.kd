// یاری: چرا بکوژێنەوە 💡 — هەر کلیکێک خانەکە و ٤ دراوسێکەی دەگۆڕێت (ڕووناک ↔ تاریک). هەموو چراکان بکوژێنەوە!
قەبارە(٣٥٠، ٤٢٠)
نەگۆڕ مەتر = ٥
گۆڕاو چراکان = []
گۆڕاو جووڵە = ٠
گۆڕاو بردرا = هەڵە

کار گۆڕین(x، y) {
  بۆ هەر د لە [[٠، ٠]، [١، ٠]، [-١، ٠]، [٠، ١]، [٠، -١]] {
    نەگۆڕ nx = x + د[٠]
    نەگۆڕ ny = y + د[١]
    ئەگەر nx >= ٠ و nx < مەتر و ny >= ٠ و ny < مەتر { چراکان[ny * مەتر + nx] = نەک چراکان[ny * مەتر + nx] }
  }
}

کار دەستپێکردن() {
  چراکان = []
  بۆ i لە ١ تا مەتر * مەتر { چراکان.زیادبکە(هەڵە) }
  // دروستکردنی تەختە بە کلیکی هەڕەمەکی (هەمیشە چارەسەری هەیە)
  بۆ i لە ١ تا ١٢ { گۆڕین(هەڕەمەکی(٠، ٤)، هەڕەمەکی(٠، ٤)) }
  جووڵە = ٠؛ بردرا = هەڵە
}
دەستپێکردن()

یاریبکە(() => {
  ئەگەر کلیککراوە() {
    ئەگەر بردرا { دەستپێکردن() } ئەگەرنا ئەگەر ماوسY() >= ٧٠ {
      نەگۆڕ x = خوارکە(ماوسX() / ٧٠)
      نەگۆڕ y = خوارکە((ماوسY() - ٧٠) / ٧٠)
      ئەگەر x < مەتر و y < مەتر { گۆڕین(x، y)؛ جووڵە += ١ }
      بردرا = نەک چراکان.لەخۆدەگرێت(ڕاست)
    }
  }
  پاشبنەمابکە(ڕەنگی(٢٠، ٢٠، ٣٥))
  بۆ y لە ٠ تا مەتر - ١ {
    بۆ x لە ٠ تا مەتر - ١ {
      نەگۆڕ ڕووناکە = چراکان[y * مەتر + x]
      ڕەنگبکە(ڕووناکە ? ڕەنگی(٢٥٥، ٢٢٠، ٨٠) : ڕەنگی(٤٠، ٤٥، ٧٠))
      لاکێش(x * ٧٠ + ٥، y * ٧٠ + ٧٥، ٦٠، ٦٠)
      ئەگەر ڕووناکە { ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٠٠، ٠٫٦))؛ بازنە(x * ٧٠ + ٣٥، y * ٧٠ + ١٠٥، ١٥) }
    }
  }
  ڕەنگبکە("سپی")
  نووسین("جووڵە: " + جووڵە، ١٥، ٤٠، ٢٤)
  نووسین(بردرا ? "🎉 هەموو کوژاونەتەوە! کلیک = دووبارە" : "چراکان بکوژێنەوە", بردرا ? ٢٠ : ١٨٠، ٤٠، بردرا ? ١٥ : ١٨)
})
