// یاری: ماسی گەورە 🐟 — ماسییەکەت بە ماوس بجووڵێنە. ماسی بچووکتر لە خۆت بخۆ بۆ گەورەبوون، لە ماسی گەورەتر ڕابکە!
قەبارە(٥٠٠، ٣٢٠)
گۆڕاو x = ٢٥٠
گۆڕاو y = ١٦٠
گۆڕاو r = ١٢
گۆڕاو ماسییەکان = []
گۆڕاو خاڵ = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو کات = ٠
گۆڕاو ئاڕاستە = ١

کار دووبارە() { x = ٢٥٠؛ y = ١٦٠؛ r = ١٢؛ ماسییەکان = []؛ خاڵ = ٠؛ مردووە = هەڵە }

یاریبکە(() => {
  کات += ١
  ئەگەر نەک مردووە {
    ئەگەر ماوسX() >= ٠ {
      نەگۆڕ پێشوو = x
      x += (ماوسX() - x) * ٠٫٠٦
      y += (ماوسY() - y) * ٠٫٠٦
      ئەگەر ڕەها(x - پێشوو) > ٠٫٣ { ئاڕاستە = x > پێشوو ? ١ : -١ }
    }
    ئەگەر کات % ٣٥ == ٠ {
      نەگۆڕ لەچەپ = هەڕەمەکی(٠، ١) == ٠
      ماسییەکان.زیادبکە({ x: لەچەپ ? -٥٠ : ٥٥٠، y: هەڕەمەکی(٣٠، ٢٩٠)، r: هەڕەمەکی(٦، گەورەترین(١٨، خوارکە(r * ١٫٦)) + ٦)، خ: (هەڕەمەکی(١، ٣) + هەڕەمەکی(٠، ٩) / ١٠) * (لەچەپ ? ١ : -١)، ڕەنگ: هەڕەمەکی(٠، ٣٦٠) })
    }
    بۆ هەر م لە ماسییەکان {
      م.x += م.خ
      ئەگەر دووری(x، y، م.x، م.y) < r * ٠٫٨ + م.r * ٠٫٨ {
        ئەگەر r >= م.r { م.خوراوە = ڕاست؛ r += م.r * ٠٫١٥؛ خاڵ += خوارکە(م.r) } ئەگەرنا { مردووە = ڕاست }
      }
    }
    ماسییەکان = ماسییەکان.پاڵاوتن(م => نەک م.خوراوە و م.x > -٨٠ و م.x < ٥٨٠)
  } ئەگەرنا ئەگەر کلیککراوە() { دووبارە() }

  پاشبنەمابکە(ڕەنگی(٢٠، ٨٠، ١٤٠))
  ڕەنگبکە(ڕەنگی(٣٠، ١٠٠، ١٦٠، ٠٫٥))
  بۆ i لە ٠ تا ٤ { لاکێش(٠، i * ٦٥، ٥٠٠، ٣٠) }
  ڕەنگبکە(ڕەنگی(٢٠٠، ١٨٠، ١٠٠))
  لاکێش(٠، ٣٠٥، ٥٠٠، ١٥)
  بۆ هەر م لە ماسییەکان {
    ڕەنگبکە(پەلکەزێڕینە(م.ڕەنگ، م.r > r ? ١ : ٠٫٨))
    بازنە(م.x، م.y، م.r)
    ئەگەر م.خ > ٠ { سێگۆشە(م.x - م.r * ٠٫٦، م.y، م.x - م.r * ١٫٦، م.y - م.r * ٠٫٦، م.x - م.r * ١٫٦، م.y + م.r * ٠٫٦) } ئەگەرنا { سێگۆشە(م.x + م.r * ٠٫٦، م.y، م.x + م.r * ١٫٦، م.y - م.r * ٠٫٦، م.x + م.r * ١٫٦، م.y + م.r * ٠٫٦) }
    ڕەنگبکە("سپی")
    بازنە(م.x + (م.خ > ٠ ? ١ : -١) * م.r * ٠٫٤، م.y - م.r * ٠٫٢، م.r * ٠٫٢)
    ڕەنگبکە("ڕەش")
    بازنە(م.x + (م.خ > ٠ ? ١ : -١) * م.r * ٠٫٤، م.y - م.r * ٠٫٢، م.r * ٠٫١)
  }
  ڕەنگبکە("نارنجی")
  بازنە(x، y، r)
  سێگۆشە(x - ئاڕاستە * r * ٠٫٦، y، x - ئاڕاستە * r * ١٫٧، y - r * ٠٫٧، x - ئاڕاستە * r * ١٫٧، y + r * ٠٫٧)
  ڕەنگبکە("سپی")
  بازنە(x + ئاڕاستە * r * ٠٫٤، y - r * ٠٫٢، r * ٠٫٢)
  ڕەنگبکە("ڕەش")
  بازنە(x + ئاڕاستە * r * ٠٫٤، y - r * ٠٫٢، r * ٠٫١)
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٥، ٢٠)
  نووسین("قەبارە: " + خوارکە(r)، ٣٩٠، ٢٥، ٢٠)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٥٠٠، ٣٢٠)
    ڕەنگبکە("سپی")
    نووسین("خورایتەوە! خاڵ: " + خاڵ، ١٥٠، ١٥٠، ٣٠)
    نووسین("کلیک = دووبارە", ٢٠٠، ١٩٠، ٢٠)
  }
})
