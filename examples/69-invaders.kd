// یاری: داگیرکەرانی ئاسمان 👾 — ← → بجووڵێ و بە بۆشایی بتەقێنە. هەر ڕیزەکە بەرەو خوارەوە دێت، پێش ئەوەی بگاتە تۆ بیانتەقێنە!
قەبارە(٤٨٠، ٤٢٠)
گۆڕاو ئەلیانەکان = []
گۆڕاو ئاڕاستە = ١
گۆڕاو کەشتی = ٢١٠
گۆڕاو گوللە = هیچ
گۆڕاو گوللەی_دوژمن = []
گۆڕاو خاڵ = ٠
گۆڕاو ژیان = ٣
گۆڕاو شەپۆل = ١
گۆڕاو کات = ٠
گۆڕاو پێشوو = هەڵە

کار شەپۆلی_نوێ() {
  ئەلیانەکان = []
  بۆ ڕ لە ٠ تا ٣ { بۆ س لە ٠ تا ٧ { ئەلیانەکان.زیادبکە({ x: ٤٠ + س * ٤٨، y: ٥٠ + ڕ * ٣٨، ڕ: ڕ }) } }
  ئاڕاستە = ١؛ گوللەی_دوژمن = []
}
شەپۆلی_نوێ()

یاریبکە(() => {
  کات += ١
  ئەگەر ژیان > ٠ {
    ئەگەر کلیل("چەپ") { کەشتی -= ٥ }
    ئەگەر کلیل("ڕاست") { کەشتی += ٥ }
    کەشتی = سنوور(کەشتی، ١٠، ٤٣٠)
    ئەگەر (کلیل("بۆشایی") یان ماوسگیراوە()) و نەک گوللە { گوللە = { x: کەشتی + ١٩، y: ٣٧٠ } }
    ئەگەر گوللە { گوللە.y -= ٩؛ ئەگەر گوللە.y < ٠ { گوللە = هیچ } }

    نەگۆڕ خێرایی = ٠٫٣ + شەپۆل * ٠٫١ + (٣٢ - ئەلیانەکان.درێژی) * ٠٫٠٣
    گۆڕاو گۆڕین = هەڵە
    بۆ هەر ئ لە ئەلیانەکان {
      ئ.x += ئاڕاستە * خێرایی
      ئەگەر ئ.x > ٤٤٠ یان ئ.x < ١٠ { گۆڕین = ڕاست }
    }
    ئەگەر گۆڕین { ئاڕاستە = -ئاڕاستە؛ بۆ هەر ئ لە ئەلیانەکان { ئ.y += ١٥ } }

    ئەگەر گوللە {
      بۆ هەر ئ لە ئەلیانەکان {
        ئەگەر گوللە و گوللە.x > ئ.x و گوللە.x < ئ.x + ٣٢ و گوللە.y > ئ.y و گوللە.y < ئ.y + ٢٤ {
          ئ.مردووە = ڕاست؛ گوللە = هیچ؛ خاڵ += (٤ - ئ.ڕ) * ١٠
        }
      }
    }
    ئەلیانەکان = ئەلیانەکان.پاڵاوتن(ئ => نەک ئ.مردووە)

    ئەگەر ئەلیانەکان.درێژی > ٠ و کات % گەورەترین(٢٠، ٧٠ - شەپۆل * ٨) == ٠ {
      نەگۆڕ ئ = ئەلیانەکان[هەڕەمەکی(٠، ئەلیانەکان.درێژی - ١)]
      گوللەی_دوژمن.زیادبکە({ x: ئ.x + ١٦، y: ئ.y + ٢٤ })
    }
    بۆ هەر گ لە گوللەی_دوژمن {
      گ.y += ٤
      ئەگەر گ.y > ٣٧٠ و گ.y < ٣٩٠ و گ.x > کەشتی و گ.x < کەشتی + ٤٠ { گ.مردووە = ڕاست؛ ژیان -= ١ }
    }
    گوللەی_دوژمن = گوللەی_دوژمن.پاڵاوتن(گ => نەک گ.مردووە و گ.y < ٤٢٠)
    بۆ هەر ئ لە ئەلیانەکان { ئەگەر ئ.y > ٣٤٠ { ژیان = ٠ } }
    ئەگەر ئەلیانەکان.درێژی == ٠ { شەپۆل += ١؛ شەپۆلی_نوێ() }
  } ئەگەرنا ئەگەر کلیککراوە() { ژیان = ٣؛ خاڵ = ٠؛ شەپۆل = ١؛ گوللە = هیچ؛ شەپۆلی_نوێ() }

  پاشبنەمابکە(ڕەنگی(٥، ٥، ٢٠))
  بۆ هەر ئ لە ئەلیانەکان {
    ڕەنگبکە(پەلکەزێڕینە(ئ.ڕ * ٥٠ + ١٠٠))
    لاکێش(ئ.x + ٤، ئ.y + ٤، ٢٤، ١٤)
    لاکێش(ئ.x، ئ.y + ٨، ٣٢، ٦)
    لاکێش(ئ.x + (کات % ٣٠ < ١٥ ? ٢ : ٦)، ئ.y + ١٨، ٦، ٦)
    لاکێش(ئ.x + ٢٤ - (کات % ٣٠ < ١٥ ? ٢ : ٦)، ئ.y + ١٨، ٦، ٦)
    ڕەنگبکە("ڕەش")
    لاکێش(ئ.x + ٩، ئ.y + ٩، ٤، ٤)؛ لاکێش(ئ.x + ١٩، ئ.y + ٩، ٤، ٤)
  }
  ڕەنگبکە("زەرد")
  ئەگەر گوللە { لاکێش(گوللە.x - ١، گوللە.y، ٣، ١٢) }
  ڕەنگبکە("سوور")
  بۆ هەر گ لە گوللەی_دوژمن { لاکێش(گ.x - ١، گ.y، ٣، ١٠) }
  ئەگەر ژیان > ٠ {
    ڕەنگبکە("ئاسمانی")
    لاکێش(کەشتی، ٣٨٠، ٤٠، ١٠)
    سێگۆشە(کەشتی + ١٠، ٣٨٠، کەشتی + ٣٠، ٣٨٠، کەشتی + ٢٠، ٣٦٥)
  }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٥، ٢٠)
  نووسین("شەپۆل " + شەپۆل + "   ❤ " + گەورەترین(ژیان، ٠)، ٣١٠، ٢٥، ١٨)
  ئەگەر ژیان <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٤٨٠، ٤٢٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! خاڵ: " + خاڵ، ١٦٠، ١٩٠، ٣٠)
    نووسین("کلیک = دووبارە", ٢٠٠، ٢٣٠، ٢٠)
  }
})
