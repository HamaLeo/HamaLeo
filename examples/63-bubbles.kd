// یاری: بووڵەکان 🫧 — بووڵەکان بپەڕێنە بە کلیک پێش ئەوەی لە سەرەوە دەربچن. کلیکی دووی یەک = کۆمبۆی زیاتر!
قەبارە(٤٠٠، ٥٠٠)
گۆڕاو بووڵەکان = []
گۆڕاو پارچەکان = []
گۆڕاو خاڵ = ٠
گۆڕاو ژیان = ٥
گۆڕاو کات = ٠
گۆڕاو کۆمبۆ = ٠
گۆڕاو کۆمبۆکات = ٠
گۆڕاو بەرزترین = ٠

کار دووبارە() { بووڵەکان = []؛ پارچەکان = []؛ خاڵ = ٠؛ ژیان = ٥؛ کۆمبۆ = ٠ }

یاریبکە(() => {
  کات += ١
  ئەگەر ژیان > ٠ {
    ئەگەر کات % گەورەترین(١٢، ٥٥ - خوارکە(خاڵ / ١٠)) == ٠ {
      بووڵەکان.زیادبکە({ x: هەڕەمەکی(٣٠، ٣٧٠)، y: ٥٣٠، r: هەڕەمەکی(١٨، ٣٨)، خ: هەڕەمەکی(١، ٣) + خاڵ / ٦٠، ڕەنگ: هەڕەمەکی(٠، ٣٦٠) })
    }
    کۆمبۆکات -= ١
    ئەگەر کۆمبۆکات <= ٠ { کۆمبۆ = ٠ }
    ئەگەر کلیککراوە() {
      گۆڕاو گرتی = هەڵە
      بۆ هەر ب لە بووڵەکان {
        ئەگەر نەک گرتی و دووری(ماوسX()، ماوسY()، ب.x، ب.y) < ب.r {
          ب.پەڕی = ڕاست؛ گرتی = ڕاست
          کۆمبۆ += ١؛ کۆمبۆکات = ٦٠
          خاڵ += کۆمبۆ
          بۆ i لە ١ تا ٨ { پارچەکان.زیادبکە({ x: ب.x، y: ب.y، vx: هەڕەمەکی(-٤، ٤)، vy: هەڕەمەکی(-٤، ٤)، ژیان: ٢٠، ڕەنگ: ب.ڕەنگ }) }
        }
      }
      ئەگەر نەک گرتی { کۆمبۆ = ٠ }
    }
    بۆ هەر ب لە بووڵەکان {
      ب.y -= ب.خ
      ب.x += سینۆس((کات + ب.ڕەنگ) / ١٥) * ٠٫٦
      ئەگەر ب.y < -ب.r { ب.پەڕی = ڕاست؛ ژیان -= ١ }
    }
    بووڵەکان = بووڵەکان.پاڵاوتن(ب => نەک ب.پەڕی)
    بەرزترین = گەورەترین(بەرزترین، خاڵ)
  } ئەگەرنا ئەگەر کلیککراوە() { دووبارە() }
  بۆ هەر پ لە پارچەکان { پ.x += پ.vx؛ پ.y += پ.vy؛ پ.ژیان -= ١ }
  پارچەکان = پارچەکان.پاڵاوتن(پ => پ.ژیان > ٠)

  پاشبنەمابکە(ڕەنگی(١٠، ٣٠، ٦٠))
  ڕەنگبکە(ڕەنگی(١٥، ٤٥، ٩٠))
  لاکێش(٠، ٣٥٠، ٤٠٠، ١٥٠)
  بۆ هەر ب لە بووڵەکان {
    ڕەنگبکە(پەلکەزێڕینە(ب.ڕەنگ، ٠٫٥))
    بازنە(ب.x، ب.y، ب.r)
    هێڵڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٧))
    ئەستووریبکە(٢)
    بازنەهێڵ(ب.x، ب.y، ب.r)
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٦))
    بازنە(ب.x - ب.r * ٠٫٣، ب.y - ب.r * ٠٫٣، ب.r * ٠٫٢)
  }
  بۆ هەر پ لە پارچەکان { ڕەنگبکە(پەلکەزێڕینە(پ.ڕەنگ، پ.ژیان / ٢٠))؛ بازنە(پ.x، پ.y، ٣) }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٣٠، ٢٤)
  نووسین("❤ " + گەورەترین(ژیان، ٠)، ٣٤٠، ٣٠، ٢٤)
  ئەگەر کۆمبۆ > ١ { نووسین("کۆمبۆ ×" + کۆمبۆ، ١٤٠، ٦٥، ٢٨) }
  ئەگەر ژیان <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٤٠٠، ٥٠٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! خاڵ: " + خاڵ، ٩٠، ٢٣٠، ٢٨)
    نووسین("باشترین: " + بەرزترین، ١٣٠، ٢٧٠، ٢٢)
    نووسین("کلیک = دووبارە", ١٣٥، ٣١٠، ٢٠)
  }
})
