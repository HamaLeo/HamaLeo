// یاری: سندووقەکان 📦 — بە تیرەکان سندووقەکان پاڵ بنێ بۆ جێگە سەوزەکان (تەنها پاڵ، کێشان نییە). R = دووبارەکردنەوەی قۆناغ
قەبارە(٣٦٠، ٣٠٠)
// # دیوار   - زەوی   . جێگە   $ سندووق   @ تۆ
نەگۆڕ قۆناغەکان = [
  ["#######"،
   "#-----#"،
   "#-$-.-#"،
   "#--@--#"،
   "#######"]،
  ["#########"،
   "#-------#"،
   "#-$--.--#"،
   "#-@-$.--#"،
   "#########"]،
  ["########"،
   "#-.-.--#"،
   "#--$$--#"،
   "#--@---#"،
   "########"]،
]
گۆڕاو قۆناغ = ٠
گۆڕاو دیوارەکان = {}
گۆڕاو جێگەکان = []
گۆڕاو سندووقەکان = []
گۆڕاو px = ٠
گۆڕاو py = ٠
گۆڕاو هەنگاو = ٠
گۆڕاو پێشوو = هەڵە
گۆڕاو بردرا = هەڵە

کار بارکردن(ق) {
  دیوارەکان = {}؛ جێگەکان = []؛ سندووقەکان = []؛ هەنگاو = ٠؛ بردرا = هەڵە
  نەگۆڕ نەخشە = قۆناغەکان[ق]
  بۆ y لە ٠ تا نەخشە.درێژی - ١ {
    بۆ x لە ٠ تا نەخشە[y].درێژی - ١ {
      نەگۆڕ ش = نەخشە[y][x]
      ئەگەر ش == "#" { دیوارەکان[x + "," + y] = ڕاست }
      ئەگەر ش == "." { جێگەکان.زیادبکە({ x: x، y: y }) }
      ئەگەر ش == "$" { سندووقەکان.زیادبکە({ x: x، y: y }) }
      ئەگەر ش == "@" { px = x؛ py = y }
    }
  }
}
بارکردن(٠)

کار سندووق_لێرە(x، y) {
  بۆ هەر س لە سندووقەکان { ئەگەر س.x == x و س.y == y { گەڕێنەوە س } }
  گەڕێنەوە هیچ
}
کار جێگە_لێرە(x، y) {
  بۆ هەر ج لە جێگەکان { ئەگەر ج.x == x و ج.y == y { گەڕێنەوە ڕاست } }
  گەڕێنەوە هەڵە
}

یاریبکە(() => {
  نەگۆڕ dx = کلیل("چەپ") ? -١ : کلیل("ڕاست") ? ١ : ٠
  نەگۆڕ dy = کلیل("سەرەوە") ? -١ : کلیل("خوارەوە") ? ١ : ٠
  نەگۆڕ دابگیراوە = dx != ٠ یان dy != ٠
  ئەگەر کلیل("r") { بارکردن(قۆناغ) }
  ئەگەر دابگیراوە و نەک پێشوو و نەک بردرا {
    نەگۆڕ nx = px + dx
    نەگۆڕ ny = py + dy
    ئەگەر نەک دیوارەکان[nx + "," + ny] {
      نەگۆڕ س = سندووق_لێرە(nx، ny)
      ئەگەر س {
        نەگۆڕ mx = nx + dx
        نەگۆڕ my = ny + dy
        ئەگەر نەک دیوارەکان[mx + "," + my] و نەک سندووق_لێرە(mx، my) {
          س.x = mx؛ س.y = my؛ px = nx؛ py = ny؛ هەنگاو += ١
        }
      } ئەگەرنا { px = nx؛ py = ny؛ هەنگاو += ١ }
    }
    بردرا = سندووقەکان.پاڵاوتن(س => جێگە_لێرە(س.x، س.y)).درێژی == سندووقەکان.درێژی
  }
  پێشوو = دابگیراوە
  ئەگەر بردرا و کلیککراوە() { قۆناغ = (قۆناغ + ١) % قۆناغەکان.درێژی؛ بارکردن(قۆناغ) }

  پاشبنەمابکە(ڕەنگی(٣٠، ٢٥، ٢٠))
  نەگۆڕ نەخشە = قۆناغەکان[قۆناغ]
  نەگۆڕ ئۆفسێتx = (٣٦٠ - نەخشە[٠].درێژی * ٤٠) / ٢
  بۆ y لە ٠ تا نەخشە.درێژی - ١ {
    بۆ x لە ٠ تا نەخشە[y].درێژی - ١ {
      نەگۆڕ X = ئۆفسێتx + x * ٤٠
      نەگۆڕ Y = y * ٤٠ + ٣٠
      ئەگەر دیوارەکان[x + "," + y] {
        ڕەنگبکە(ڕەنگی(١٢٠، ٩٠، ٧٠))؛ لاکێش(X، Y، ٤٠، ٤٠)
        ڕەنگبکە(ڕەنگی(١٥٠، ١١٠، ٩٠))؛ لاکێش(X + ٢، Y + ٢، ٣٦، ٣٦)
      } ئەگەرنا {
        ڕەنگبکە(ڕەنگی(٧٠، ٦٠، ٥٠))؛ لاکێش(X + ١، Y + ١، ٣٨، ٣٨)
      }
    }
  }
  بۆ هەر ج لە جێگەکان { ڕەنگبکە("سەوز")؛ بازنە(ئۆفسێتx + ج.x * ٤٠ + ٢٠، ج.y * ٤٠ + ٥٠، ٨) }
  بۆ هەر س لە سندووقەکان {
    ڕەنگبکە(جێگە_لێرە(س.x، س.y) ? ڕەنگی(٦٠، ١٨٠، ٨٠) : ڕەنگی(٢٢٠، ١٦٠، ٨٠))
    لاکێش(ئۆفسێتx + س.x * ٤٠ + ٤، س.y * ٤٠ + ٣٤، ٣٢، ٣٢)
    ڕەنگبکە(ڕەنگی(١٢٠، ٨٠، ٣٠))
    لاکێش(ئۆفسێتx + س.x * ٤٠ + ٤، س.y * ٤٠ + ٤٨، ٣٢، ٤)
  }
  ڕەنگبکە("ئاسمانی")
  بازنە(ئۆفسێتx + px * ٤٠ + ٢٠، py * ٤٠ + ٥٠، ١٤)
  ڕەنگبکە("سپی")
  بازنە(ئۆفسێتx + px * ٤٠ + ١٥، py * ٤٠ + ٤٦، ٣)؛ بازنە(ئۆفسێتx + px * ٤٠ + ٢٥، py * ٤٠ + ٤٦، ٣)
  ڕەنگبکە("سپی")
  نووسین("قۆناغ " + (قۆناغ + ١) + "   هەنگاو: " + هەنگاو، ١٠، ٢٢، ١٨)
  ئەگەر بردرا { نووسین("🎉 تەواو بوو! کلیک = قۆناغی داهاتوو", ٣٠، ٢٨٠، ٢٠) }
})
