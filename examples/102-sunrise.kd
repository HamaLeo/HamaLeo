// 🌅 بەرەبەیان — خۆر هەڵدێت و ئاسمان لە شەوەوە دەگۆڕێت بۆ بەرەبەیان و ڕۆژ. کلیک بکە بۆ دووبارەکردنەوە
قەبارە(٤٥٠، ٣٠٠)
گۆڕاو کات = ٠
نەگۆڕ باڵندەکان = []
بۆ i لە ١ تا ٦ { باڵندەکان.زیادبکە({ x: هەڕەمەکی(٠، ٤٥٠)، y: هەڕەمەکی(٥٠، ١٣٠)، خ: هەڕەمەکی(٥، ١٥) / ١٠ }) }
یاریبکە(() => {
  ئەگەر کلیککراوە() { کات = ٠ }
  کات = بچووکترین(١، کات + ٠٫٠٠٢٥)
  نەگۆڕ ڕووناکی = کات
  // گرادیەنتی ئاسمان
  بۆ i لە ٠ تا ٢٩ {
    نەگۆڕ پ = i / ٣٠
    نەگۆڕ r = ٢٠ + ڕووناکی * (٢٣٠ - ٢٠) * (١ - پ * ٠٫٥)
    نەگۆڕ g = ٢٠ + ڕووناکی * (١٥٠ + پ * ٥٠ - ٢٠)
    نەگۆڕ b = ٦٠ + ڕووناکی * ١٣٠ + (١ - ڕووناکی) * پ * ٤٠
    ڕەنگبکە(ڕەنگی(r، g، b))
    لاکێش(٠، i * ٧، ٤٥٠، ٨)
  }
  // ئەستێرەکان لە شەودا
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ١ - ڕووناکی * ٢))
  بۆ i لە ٠ تا ٣٠ { بازنە((i * ١٣٧) % ٤٥٠، (i * ٧١) % ١٥٠، ١٫٢) }
  // خۆر
  نەگۆڕ خx = ٢٢٥ + کۆسینۆس(پای * (١ - کات)) * -٢٠٠
  نەگۆڕ خy = ٢٣٠ - سینۆس(پای * کات * ٠٫٦) * ١٨٠
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٠٠، ١٠٠، ٠٫٢))
  بازنە(خx، خy، ٦٠)
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٣٠ - ٣٠ * (١ - کات)، ١٢٠ + ٦٠ * کات))
  بازنە(خx، خy، ٣٠)
  // باڵندەکان
  هێڵڕەنگبکە(ڕەنگی(٢٠، ٢٠، ٣٠))
  ئەستووریبکە(٢)
  بۆ هەر ب لە باڵندەکان {
    ب.x = (ب.x + ب.خ) % ٤٥٠
    نەگۆڕ باڵ = سینۆس(ب.x / ٨) * ٥
    هێڵ(ب.x - ٨، ب.y + باڵ، ب.x، ب.y)؛ هێڵ(ب.x، ب.y، ب.x + ٨، ب.y + باڵ)
  }
  // کێوەکان
  ڕەنگبکە(ڕەنگی(٣٠ + ٥٠ * کات، ٢٥ + ٦٠ * کات، ٦٠ + ٤٠ * کات))
  سێگۆشە(٠، ٢٣٠، ١٢٠، ١٣٠، ٢٥٠، ٢٣٠)
  سێگۆشە(١٦٠، ٢٣٠، ٣٠٠، ١٢٠، ٤٥٠، ٢٣٠)
  ڕەنگبکە(ڕەنگی(١٥ + ٣٠ * کات، ٢٠ + ٦٠ * کات، ٣٥ + ٢٠ * کات))
  لاکێش(٠، ٢٣٠، ٤٥٠، ٧٠)
})
