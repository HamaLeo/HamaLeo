// ⚙ ددانەدار — سێ چەرخی ددانەدار کە بە یەکەوە دەسووڕێن. چەرخی بچووک خێراتر دەسووڕێت!
قەبارە(٤٥٠، ٣٢٠)
گۆڕاو کات = ٠

کار چەرخ(cx، cy، r، ددان، گۆشە، ڕەنگ) {
  ڕەنگبکە(ڕەنگ)
  بازنە(cx، cy، r)
  بۆ i لە ٠ تا ددان - ١ {
    نەگۆڕ g = گۆشە + i * ٢ * پای / ددان
    نەگۆڕ پان = پای / ددان * ٠٫٤
    سێگۆشە(cx + کۆسینۆس(g - پان) * (r - ٢)، cy + سینۆس(g - پان) * (r - ٢)،
           cx + کۆسینۆس(g + پان) * (r - ٢)، cy + سینۆس(g + پان) * (r - ٢)،
           cx + کۆسینۆس(g) * (r + ١٤)، cy + سینۆس(g) * (r + ١٤))
  }
  ڕەنگبکە(ڕەنگی(٢٠، ٢٥، ٤٥))
  بازنە(cx، cy، r * ٠٫٤)
  ڕەنگبکە(ڕەنگ)
  بۆ i لە ٠ تا ٣ { بازنە(cx + کۆسینۆس(گۆشە * ١ + i * پای / ٢) * r * ٠٫٦٥، cy + سینۆس(گۆشە + i * پای / ٢) * r * ٠٫٦٥، r * ٠٫٠٨) }
}

یاریبکە(() => {
  کات += ٠٫٠٢
  پاشبنەمابکە(ڕەنگی(٢٠، ٢٥، ٤٥))
  // ددانی ١٦ ← ٨ ← ١٦ : نیسبەتی ٢ بۆ ١
  چەرخ(١٣٠، ١٦٠، ٧٠، ١٦، کات، ڕەنگی(٢٣٠، ١٦٠، ٥٠))
  چەرخ(١٣٠ + ٧٠ + ٣٥ + ١٠، ١٦٠، ٣٥، ٨، -کات * ٢ + پای / ٨، ڕەنگی(٦٠، ١٦٠، ٢٢٠))
  چەرخ(١٣٠ + ٧٠ + ٣٥ + ١٠ + ٣٥ + ٧٠ + ١٠، ١٦٠، ٧٠، ١٦، کات + پای / ١٦، ڕەنگی(٥٠، ٢٠٠، ١٣٠))
})
