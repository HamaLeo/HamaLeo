// یاری: پاراستنی قەڵا 🏰 — لەسەر زەوی سەوزەکان کلیک بکە بۆ دانانی تاوەر (٥٠ زێڕ). تاوەرەکان دوژمنەکان دەتەقێنن. پێش ئەوەی بگەنە کۆتایی ڕێگا ڕایانبگرە!
قەبارە(٥٠٠، ٣٤٠)
// خاڵەکانی ڕێگا (ستوون، ڕیز) — هەر خانەیەک ٥٠ پیکسڵ
نەگۆڕ ڕێگا = [[٠، ١]، [٨، ١]، [٨، ٣]، [١، ٣]، [١، ٥]، [٩، ٥]]
گۆڕاو خانەی_ڕێگا = {}
گۆڕاو تاوەرەکان = []
گۆڕاو دوژمنەکان = []
گۆڕاو زێڕ = ١٠٠
گۆڕاو ژیان = ١٠
گۆڕاو شەپۆل = ١
گۆڕاو کات = ٠
گۆڕاو دروستکراو = ٠
گۆڕاو خاڵ = ٠
گۆڕاو تیرەکان = []

کار ناوەند(ج) { گەڕێنەوە { x: ج[٠] * ٥٠ + ٢٥، y: ج[١] * ٥٠ + ٦٥ } }

کار ڕێگاساز() {
  خانەی_ڕێگا = {}
  بۆ i لە ٠ تا ڕێگا.درێژی - ٢ {
    نەگۆڕ a = ڕێگا[i]
    نەگۆڕ b = ڕێگا[i + ١]
    نەگۆڕ gx = b[٠] > a[٠] ? ١ : b[٠] < a[٠] ? -١ : ٠
    نەگۆڕ gy = b[١] > a[١] ? ١ : b[١] < a[١] ? -١ : ٠
    گۆڕاو cx = a[٠]
    گۆڕاو cy = a[١]
    هەتا cx != b[٠] یان cy != b[١] { خانەی_ڕێگا[cx + "," + cy] = ڕاست؛ cx += gx؛ cy += gy }
    خانەی_ڕێگا[b[٠] + "," + b[١]] = ڕاست
  }
}
ڕێگاساز()

کار دووبارە() { تاوەرەکان = []؛ دوژمنەکان = []؛ زێڕ = ١٠٠؛ ژیان = ١٠؛ شەپۆل = ١؛ کات = ٠؛ دروستکراو = ٠؛ خاڵ = ٠ }

یاریبکە(() => {
  کات += ١
  ئەگەر ژیان > ٠ {
    ئەگەر کلیککراوە() و ماوسY() > ٤٠ {
      نەگۆڕ c = خوارکە(ماوسX() / ٥٠)
      نەگۆڕ r = خوارکە((ماوسY() - ٤٠) / ٥٠)
      نەگۆڕ داگیرکراوە = تاوەرەکان.پاڵاوتن(ت => ت.c == c و ت.r == r).درێژی > ٠
      ئەگەر نەک خانەی_ڕێگا[c + "," + r] و نەک داگیرکراوە و زێڕ >= ٥٠ و c < ١٠ و r < ٦ {
        تاوەرەکان.زیادبکە({ c: c، r: r، ساردبوونەوە: ٠ })؛ زێڕ -= ٥٠
      }
    }
    // دوژمنی نوێ: هەر شەپۆلێک ١٠ + شەپۆل*٤
    ئەگەر دروستکراو < ٨ + شەپۆل * ٤ و کات % ٤٠ == ٠ {
      نەگۆڕ دەستپێک = ناوەند(ڕێگا[٠])
      دوژمنەکان.زیادبکە({ x: -٢٠، y: دەستپێک.y، ئامانج: ١، ژیانی: ٣ + شەپۆل * ٢، زۆرترین: ٣ + شەپۆل * ٢، خ: ١٫٢ + شەپۆل * ٠٫١ })
      دروستکراو += ١
    }
    بۆ هەر د لە دوژمنەکان {
      نەگۆڕ ئا = ناوەند(ڕێگا[د.ئامانج])
      نەگۆڕ دوور = دووری(د.x، د.y، ئا.x، ئا.y)
      ئەگەر دوور < د.خ + ٠٫٥ {
        د.x = ئا.x؛ د.y = ئا.y؛ د.ئامانج += ١
        ئەگەر د.ئامانج >= ڕێگا.درێژی { د.گەیشت = ڕاست؛ ژیان -= ١ }
      } ئەگەرنا { د.x += (ئا.x - د.x) / دوور * د.خ؛ د.y += (ئا.y - د.y) / دوور * د.خ }
    }
    // تاوەرەکان
    بۆ هەر ت لە تاوەرەکان {
      ت.ساردبوونەوە -= ١
      ئەگەر ت.ساردبوونەوە <= ٠ {
        نەگۆڕ ن = ناوەند([ت.c، ت.r])
        گۆڕاو ئامانج = هیچ
        بۆ هەر د لە دوژمنەکان {
          ئەگەر نەک د.گەیشت و دووری(ن.x، ن.y، د.x، د.y) < ١٢٠ {
            ئەگەر نەک ئامانج یان د.ئامانج > ئامانج.ئامانج { ئامانج = د }
          }
        }
        ئەگەر ئامانج {
          ئامانج.ژیانی -= ١
          ت.ساردبوونەوە = ٢٠
          تیرەکان.زیادبکە({ a: ن.x، b: ن.y، c: ئامانج.x، d: ئامانج.y، ژیان: ٥ })
          ئەگەر ئامانج.ژیانی <= ٠ { ئامانج.مردووە = ڕاست؛ زێڕ += ١٠؛ خاڵ += ١٠ }
        }
      }
    }
    دوژمنەکان = دوژمنەکان.پاڵاوتن(د => نەک د.مردووە و نەک د.گەیشت)
    ئەگەر دروستکراو >= ٨ + شەپۆل * ٤ و دوژمنەکان.درێژی == ٠ { شەپۆل += ١؛ دروستکراو = ٠؛ زێڕ += ٣٠ }
  } ئەگەرنا ئەگەر کلیککراوە() { دووبارە() }
  بۆ هەر ی لە تیرەکان { ی.ژیان -= ١ }
  تیرەکان = تیرەکان.پاڵاوتن(ی => ی.ژیان > ٠)

  پاشبنەمابکە(ڕەنگی(٣٠، ٧٠، ٤٠))
  بۆ r لە ٠ تا ٥ {
    بۆ c لە ٠ تا ٩ {
      ڕەنگبکە(خانەی_ڕێگا[c + "," + r] ? ڕەنگی(١٨٠، ١٥٥، ١١٠) : ڕەنگی(٤٥ + (c + r) % ٢ * ٨، ١٠٥، ٦٠))
      لاکێش(c * ٥٠ + ١، r * ٥٠ + ٤١، ٤٨، ٤٨)
    }
  }
  بۆ هەر ت لە تاوەرەکان {
    نەگۆڕ ن = ناوەند([ت.c، ت.r])
    ڕەنگبکە(ڕەنگی(٨٠، ٨٠، ١٢٠))
    لاکێش(ن.x - ١٥، ن.y - ١٥، ٣٠، ٣٠)
    ڕەنگبکە("سوور")
    بازنە(ن.x، ن.y، ٩)
    ڕەنگبکە("سپی")
    بازنە(ن.x، ن.y، ٣)
  }
  بۆ هەر د لە دوژمنەکان {
    ڕەنگبکە(ڕەنگی(٢٢٠، ٦٠، ٦٠))
    بازنە(د.x، د.y، ١٢)
    ڕەنگبکە("ڕەش")
    لاکێش(د.x - ١٢، د.y - ٢٠، ٢٤، ٤)
    ڕەنگبکە("سەوز")
    لاکێش(د.x - ١٢، د.y - ٢٠، ٢٤ * د.ژیانی / د.زۆرترین، ٤)
  }
  هێڵڕەنگبکە("زەرد")
  ئەستووریبکە(٢)
  بۆ هەر ی لە تیرەکان { هێڵ(ی.a، ی.b، ی.c، ی.d) }
  ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
  لاکێش(٠، ٠، ٥٠٠، ٤٠)
  ڕەنگبکە("زەرد")
  نووسین("زێڕ: " + زێڕ، ١٠، ٢٧، ١٨)
  ڕەنگبکە("سپی")
  نووسین("شەپۆل " + شەپۆل، ١٥٠، ٢٧، ١٨)
  ڕەنگبکە("سوور")
  نووسین("❤ " + گەورەترین(ژیان، ٠)، ٢٧٠، ٢٧، ١٨)
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ٣٦٠، ٢٧، ١٨)
  ئەگەر ژیان <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٥٠٠، ٣٤٠)
    ڕەنگبکە("سپی")
    نووسین("قەڵا کەوت! شەپۆل " + شەپۆل، ١٤٠، ١٦٠، ٣٠)
    نووسین("کلیک = دووبارە", ٢٠٠، ٢٠٠، ٢٠)
  }
})
