// یاری: تاوەری هانۆی 🗼 — هەموو ٤ قوپەکە لە تیرەی چەپەوە بگوازەرەوە بۆ تیرەی ڕاست. قوپی گەورە نابێت لەسەر بچووک بێت! (کەمترین: ١٥ جووڵە)
قەبارە(٤٥٠، ٣٠٠)
گۆڕاو تیرەکان = [[٤، ٣، ٢، ١]، []، []]    // هەر تیرەیەک ستاکێکە (لە خوارەوە بۆ سەرەوە)
گۆڕاو هەڵبژێردراو = -١
گۆڕاو جووڵە = ٠
گۆڕاو پەیام = ""
گۆڕاو پەیامکات = ٠

کار دەستپێکردن() { تیرەکان = [[٤، ٣، ٢، ١]، []، []]؛ هەڵبژێردراو = -١؛ جووڵە = ٠ }

یاریبکە(() => {
  پەیامکات -= ١
  ئەگەر کلیککراوە() {
    نەگۆڕ ت = خوارکە(ماوسX() / ١٥٠)
    ئەگەر تیرەکان[٢].درێژی == ٤ { دەستپێکردن() } ئەگەرنا ئەگەر ت >= ٠ و ت <= ٢ {
      ئەگەر هەڵبژێردراو == -١ {
        ئەگەر تیرەکان[ت].درێژی > ٠ { هەڵبژێردراو = ت }
      } ئەگەرنا ئەگەر ت == هەڵبژێردراو { هەڵبژێردراو = -١ } ئەگەرنا {
        نەگۆڕ لە = تیرەکان[هەڵبژێردراو]
        نەگۆڕ بۆتیرە = تیرەکان[ت]
        نەگۆڕ قوپ = لە[لە.درێژی - ١]
        ئەگەر بۆتیرە.درێژی == ٠ یان بۆتیرە[بۆتیرە.درێژی - ١] > قوپ {
          لە.لابەرە()؛ بۆتیرە.زیادبکە(قوپ)؛ جووڵە += ١
        } ئەگەرنا { پەیام = "قوپی گەورە نابێت لەسەر بچووک بێت!"؛ پەیامکات = ٩٠ }
        هەڵبژێردراو = -١
      }
    }
  }
  پاشبنەمابکە(ڕەنگی(٢٥، ٣٠، ٥٠))
  بۆ i لە ٠ تا ٢ {
    ڕەنگبکە(هەڵبژێردراو == i ? ڕەنگی(٥٠، ٦٠، ١٠٠) : ڕەنگی(٣٥، ٤٠، ٦٥))
    لاکێش(i * ١٥٠ + ٥، ٤٠، ١٤٠، ٢٣٠)
    ڕەنگبکە(ڕەنگی(١٨٠، ١٨٠، ١٩٠))
    لاکێش(i * ١٥٠ + ٧١، ٦٠، ٨، ٢١٠)
    لاکێش(i * ١٥٠ + ٢٠، ٢٦٨، ١١٠، ٦)
    بۆ ک لە ٠ تا تیرەکان[i].درێژی - ١ {
      نەگۆڕ قوپ = تیرەکان[i][ک]
      ڕەنگبکە(پەلکەزێڕینە(قوپ * ٧٠))
      لاکێش(i * ١٥٠ + ٧٥ - قوپ * ١٦، ٢٤٠ - ک * ٣٠، قوپ * ٣٢، ٢٦)
    }
  }
  ڕەنگبکە("سپی")
  نووسین("جووڵە: " + جووڵە، ١٥، ٢٨، ٢٢)
  ئەگەر پەیامکات > ٠ { ڕەنگبکە("سوور")؛ نووسین(پەیام، ١٠٠، ٢٩٠، ١٨) }
  ئەگەر تیرەکان[٢].درێژی == ٤ { ڕەنگبکە("سەوز")؛ نووسین("🎉 تەواو بوو لە " + جووڵە + " جووڵە! کلیک = دووبارە", ٣٠، ٢٩٠، ١٨) }
})
