// 🎐 شەپۆلی پێندۆلەکان — ١٥ پێندۆل بە درێژی جیاواز: دەسپێکەکە پێکەوە دەجووڵێن، پاشان لێک دادەبڕێن و جارێکی تر یەک دەگرنەوە
قەبارە(٤٥٠، ٣٢٠)
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠٢
  پاشبنەمابکە(ڕەنگی(١٥، ١٨، ٣٥))
  ڕەنگبکە(ڕەنگی(٦٠، ٦٠، ٩٠))
  لاکێش(٢٠، ٢٠، ٤١٠، ٨)
  بۆ i لە ٠ تا ١٤ {
    نەگۆڕ x = ٤٠ + i * ٢٧
    نەگۆڕ درێژی = ٢٠٠ - i * ٦
    // هەر پێندۆلێک لە ماوەی ٦٠ چرکەدا (٥١ + i) خولی تەواو دەکات
    نەگۆڕ گۆشە = ٠٫٧ * سینۆس(کات * (٥١ + i) * ٠٫٠٥٢٣٦ * ٦)
    نەگۆڕ bx = x + سینۆس(گۆشە) * درێژی
    نەگۆڕ by = ٢٨ + کۆسینۆس(گۆشە) * درێژی
    هێڵڕەنگبکە(ڕەنگی(١٥٠، ١٦٠، ٢٠٠، ٠٫٦))
    ئەستووریبکە(١٫٥)
    هێڵ(x، ٢٨، bx، by)
    ڕەنگبکە(پەلکەزێڕینە(i * ٢٤))
    بازنە(bx، by، ١٠)
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٥))
    بازنە(bx - ٣، by - ٣، ٣)
  }
})
