// 📺 لۆگۆی خولاوە — لۆگۆکە لە لێوارەکان دەگەڕێتەوە و هەر جارێک ڕەنگ دەگۆڕێت. کلیک بکە بۆ لۆگۆی زیاتر! (تەماشا بکە گەیشتە گۆشە؟)
قەبارە(٤٥٠، ٣٠٠)
گۆڕاو لۆگۆکان = [{ x: ٥٠، y: ٥٠، vx: ٢، vy: ١٫٦، ڕەنگ: ٠ }]
گۆڕاو گۆشەکان = ٠
یاریبکە(() => {
  ئەگەر کلیککراوە() { لۆگۆکان.زیادبکە({ x: ماوسX() - ٥٠، y: ماوسY() - ٢٠، vx: هەڕەمەکی(١، ٤) * (هەڕەمەکی(٠، ١) == ٠ ? ١ : -١)، vy: هەڕەمەکی(١، ٣) * (هەڕەمەکی(٠، ١) == ٠ ? ١ : -١)، ڕەنگ: هەڕەمەکی(٠، ٣٦٠) }) }
  بۆ هەر ل لە لۆگۆکان {
    ل.x += ل.vx؛ ل.y += ل.vy
    گۆڕاو لێدا = هەڵە
    ئەگەر ل.x < ٠ یان ل.x > ٣٥٠ { ل.vx = -ل.vx؛ ل.x = سنوور(ل.x، ٠، ٣٥٠)؛ ل.ڕەنگ += ٦٠ + هەڕەمەکی(٠، ٦٠)؛ لێدا = ڕاست }
    ئەگەر ل.y < ٠ یان ل.y > ٢٦٠ { ل.vy = -ل.vy؛ ل.y = سنوور(ل.y، ٠، ٢٦٠)؛ ل.ڕەنگ += ٦٠ + هەڕەمەکی(٠، ٦٠)؛ ئەگەر لێدا { گۆشەکان += ١ } }
  }
  پاشبنەمابکە("ڕەش")
  بۆ هەر ل لە لۆگۆکان {
    ڕەنگبکە(پەلکەزێڕینە(ل.ڕەنگ))
    لاکێش(ل.x، ل.y، ١٠٠، ٤٠)
    ڕەنگبکە("ڕەش")
    نووسین("کۆدکەر", ل.x + ١٢، ل.y + ٢٨، ٢٢)
  }
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٥))
  نووسین("گۆشەکان: " + گۆشەکان، ٣٣٠، ٢٩٠، ١٤)
})
