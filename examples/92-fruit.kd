// یاری: بڕینی میوە 🍉 — ماوس دابگرە و بەخێرایی بەسەر میوەکاندا ڕایبکێشە بۆ بڕینیان. بۆمبەکان ⚫ مەبڕە! ٣ میوەی ڕزگارنەکراو = دۆڕان
قەبارە(٤٥٠، ٤٠٠)
گۆڕاو شتەکان = []
گۆڕاو نیوەکان = []
گۆڕاو شوێنپێ = []
گۆڕاو خاڵ = ٠
گۆڕاو ژیان = ٣
گۆڕاو کات = ٠
گۆڕاو پێشوو = { x: -١، y: -١ }
گۆڕاو مردووە = هەڵە
گۆڕاو بەرزترین = ٠

کار دووبارە() { شتەکان = []؛ نیوەکان = []؛ خاڵ = ٠؛ ژیان = ٣؛ مردووە = هەڵە؛ کات = ٠ }

یاریبکە(() => {
  کات += ١
  نەگۆڕ خێرایی_ماوس = ماوسگیراوە() و پێشوو.x >= ٠ ? دووری(ماوسX()، ماوسY()، پێشوو.x، پێشوو.y) : ٠
  ئەگەر ماوسگیراوە() { شوێنپێ.زیادبکە({ x: ماوسX()، y: ماوسY() }) } ئەگەرنا { شوێنپێ = [] }
  ئەگەر شوێنپێ.درێژی > ٨ { شوێنپێ.یەکەمیلابەرە() }
  ئەگەر نەک مردووە {
    ئەگەر کات % گەورەترین(١٤، ٥٠ - خوارکە(خاڵ / ٨)) == ٠ {
      نەگۆڕ بۆمبە = هەڕەمەکی(١، ٦) == ١
      نەگۆڕ x = هەڕەمەکی(٦٠، ٣٩٠)
      شتەکان.زیادبکە({ x: x، y: ٤٣٠، vx: (٢٢٥ - x) / ٦٠ + هەڕەمەکی(-١٠، ١٠) / ١٠، vy: -هەڕەمەکی(٩، ١٢)، r: ٢٢، بۆمبە: بۆمبە، ڕەنگ: هەڕەمەکی(٠، ٣٦٠) })
    }
    بۆ هەر ش لە شتەکان {
      ش.vy += ٠٫١٦؛ ش.x += ش.vx؛ ش.y += ش.vy
      ئەگەر ماوسگیراوە() و خێرایی_ماوس > ٦ و دووری(ماوسX()، ماوسY()، ش.x، ش.y) < ش.r + ٦ {
        ش.بڕدرا = ڕاست
        ئەگەر ش.بۆمبە { مردووە = ڕاست } ئەگەرنا {
          خاڵ += ١
          نیوەکان.زیادبکە({ x: ش.x، y: ش.y، vx: -٢، vy: ش.vy، ڕەنگ: ش.ڕەنگ، ئاڕاستە: -١ })
          نیوەکان.زیادبکە({ x: ش.x، y: ش.y، vx: ٢، vy: ش.vy، ڕەنگ: ش.ڕەنگ، ئاڕاستە: ١ })
        }
      }
      ئەگەر ش.vy > ٠ و ش.y > ٤٢٠ و نەک ش.بڕدرا { ش.بڕدرا = ڕاست؛ ئەگەر نەک ش.بۆمبە { ژیان -= ١ } }
    }
    شتەکان = شتەکان.پاڵاوتن(ش => نەک ش.بڕدرا)
    ئەگەر ژیان <= ٠ { مردووە = ڕاست }
    بەرزترین = گەورەترین(بەرزترین، خاڵ)
  } ئەگەرنا ئەگەر کلیککراوە() { دووبارە() }
  بۆ هەر ن لە نیوەکان { ن.vy += ٠٫٢؛ ن.x += ن.vx؛ ن.y += ن.vy }
  نیوەکان = نیوەکان.پاڵاوتن(ن => ن.y < ٤٣٠)
  پێشوو = { x: ماوسگیراوە() ? ماوسX() : -١، y: ماوسY() }

  پاشبنەمابکە(ڕەنگی(٣٠، ٢٥، ٤٠))
  ڕەنگبکە(ڕەنگی(٤٠، ٣٥، ٥٥))
  بۆ i لە ٠ تا ٨ { لاکێش(i * ٥٠، ٠، ٢٥، ٤٠٠) }
  بۆ هەر ش لە شتەکان {
    ئەگەر ش.بۆمبە {
      ڕەنگبکە("ڕەش")؛ بازنە(ش.x، ش.y، ش.r)
      ڕەنگبکە("سوور")؛ بازنە(ش.x، ش.y، ٦)
    } ئەگەرنا {
      ڕەنگبکە(پەلکەزێڕینە(ش.ڕەنگ))؛ بازنە(ش.x، ش.y، ش.r)
      ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٤))؛ بازنە(ش.x - ٧، ش.y - ٧، ٦)
    }
  }
  بۆ هەر ن لە نیوەکان {
    ڕەنگبکە(پەلکەزێڕینە(ن.ڕەنگ))
    سێگۆشە(ن.x، ن.y - ٢٢، ن.x، ن.y + ٢٢، ن.x + ن.ئاڕاستە * ٢٢، ن.y)
  }
  هێڵڕەنگبکە("سپی")
  ئەستووریبکە(٣)
  بۆ i لە ١ تا شوێنپێ.درێژی - ١ { هێڵ(شوێنپێ[i - ١].x، شوێنپێ[i - ١].y، شوێنپێ[i].x، شوێنپێ[i].y) }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٨، ٢٤)
  نووسین("❤ " + گەورەترین(ژیان، ٠)، ٣٩٠، ٢٨، ٢٤)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٤٥٠، ٤٠٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! خاڵ: " + خاڵ، ١٣٠، ١٨٠، ٣٠)
    نووسین("باشترین: " + بەرزترین، ١٧٠، ٢١٥، ٢٠)
    نووسین("کلیک = دووبارە", ١٦٠، ٢٥٠، ٢٠)
  }
})
