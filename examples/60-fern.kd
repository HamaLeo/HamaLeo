// 🌿 سەرخس — فراکتاڵی بارنزلی: ٨٠٠٠ خاڵ بە چوار یاسای سادە (هەڕەمەکی) دەبنە گەڵایەکی ڕاستەقینە
قەبارە(٣٦٠، ٤٢٠)
پاشبنەمابکە(ڕەنگی(١٠، ٢٠، ١٥))
گۆڕاو x = ٠
گۆڕاو y = ٠
بۆ i لە ١ تا ٨٠٠٠ {
  نەگۆڕ r = هەڕەمەکی(١، ١٠٠)
  نەگۆڕ نوێx = r <= ١ ? ٠ : r <= ٨٦ ? ٠٫٨٥ * x + ٠٫٠٤ * y : r <= ٩٣ ? ٠٫٢ * x - ٠٫٢٦ * y : -٠٫١٥ * x + ٠٫٢٨ * y
  نەگۆڕ نوێy = r <= ١ ? ٠٫١٦ * y : r <= ٨٦ ? -٠٫٠٤ * x + ٠٫٨٥ * y + ١٫٦ : r <= ٩٣ ? ٠٫٢٦ * x + ٠٫٢٢ * y + ١٫٦ : ٠٫٢٦ * x + ٠٫٢٤ * y + ٠٫٤٤
  x = نوێx؛ y = نوێy
  ڕەنگبکە(ڕەنگی(٣٠ + i / ٥٠، ١٣٠ + i / ١٠٠، ٥٠))
  بازنە(١٨٠ + x * ٣٣، ٤٠٠ - y * ٣٦، ٠٫٨)
}
