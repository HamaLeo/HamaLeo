// ⚪ شەپۆلی خاڵ — تۆڕێکی خاڵ کە لەگەڵ شەپۆل گەورە و بچووک دەبن. ماوس سەرچاوەی شەپۆلە
قەبارە(٤٥٠، ٣٢٠)
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠٥
  نەگۆڕ سx = ماوسX() >= ٠ ? ماوسX() : ٢٢٥ + سینۆس(کات / ٢) * ١٠٠
  نەگۆڕ سy = ماوسY() >= ٠ ? ماوسY() : ١٦٠ + کۆسینۆس(کات / ٣) * ٦٠
  پاشبنەمابکە(ڕەنگی(١٠، ١٢، ٢٨))
  بۆ ڕ لە ٠ تا ١٣ {
    بۆ س لە ٠ تا ٢٠ {
      نەگۆڕ x = س * ٢٢ + ١٤
      نەگۆڕ y = ڕ * ٢٢ + ١٤
      نەگۆڕ d = دووری(x، y، سx، سy)
      نەگۆڕ شەپۆل = سینۆس(d / ٢٠ - کات * ٤)
      ڕەنگبکە(پەلکەزێڕینە(d + کات * ٤٠، ٠٫٦ + ٠٫٣ * شەپۆل))
      بازنە(x، y، ٦ + ٤ * شەپۆل)
    }
  }
})
