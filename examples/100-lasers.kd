// یاری: لەیزەرەکان ⚡ — ← → بۆ گۆڕینی ستوون. هێڵی باریک ئاگادارکردنەوەیە: لەیزەر دێت! لە ستوونی ئاگایی کراو دەربچۆ
قەبارە(٣٥٠، ٤٠٠)
گۆڕاو ستوون = ٢
گۆڕاو لەیزەرەکان = []
گۆڕاو خاڵ = ٠
گۆڕاو کات = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو پێشوو = هەڵە
گۆڕاو بەرزترین = ٠

کار دووبارە() { ستوون = ٢؛ لەیزەرەکان = []؛ خاڵ = ٠؛ کات = ٠؛ مردووە = هەڵە }

یاریبکە(() => {
  کات += ١
  نەگۆڕ دەستچەپ = کلیل("چەپ")
  نەگۆڕ دەستڕاست = کلیل("ڕاست")
  ئەگەر نەک مردووە {
    ئەگەر دەستچەپ و نەک پێشوو { ستوون = گەورەترین(٠، ستوون - ١) }
    ئەگەر دەستڕاست و نەک پێشوو { ستوون = بچووکترین(٤، ستوون + ١) }
    ئەگەر ماوسگیراوە() { ستوون = سنوور(خوارکە(ماوسX() / ٧٠)، ٠، ٤) }
    ئەگەر کات % گەورەترین(٣٠، ٨٠ - خوارکە(خاڵ / ٥)) == ٠ {
      بۆ i لە ١ تا (خاڵ > ٢٠ ? ٢ : ١) {
        لەیزەرەکان.زیادبکە({ ستوون: هەڕەمەکی(٠، ٤)، کات: ٠ })
      }
    }
    بۆ هەر ل لە لەیزەرەکان {
      ل.کات += ١
      ئەگەر ل.کات > ٧٠ و ل.کات < ٩٠ و ل.ستوون == ستوون { مردووە = ڕاست }
      ئەگەر ل.کات == ٩٠ { خاڵ += ١ }
    }
    لەیزەرەکان = لەیزەرەکان.پاڵاوتن(ل => ل.کات < ٩٠)
    بەرزترین = گەورەترین(بەرزترین، خاڵ)
  } ئەگەرنا ئەگەر کلیککراوە() { دووبارە() }
  پێشوو = دەستچەپ یان دەستڕاست

  پاشبنەمابکە(ڕەنگی(١٥، ١٠، ٢٥))
  بۆ i لە ٠ تا ٤ {
    ڕەنگبکە(ڕەنگی(٢٥ + i % ٢ * ٨، ٢٠ + i % ٢ * ٨، ٤٠ + i % ٢ * ١٠))
    لاکێش(i * ٧٠، ٠، ٧٠، ٤٠٠)
  }
  بۆ هەر ل لە لەیزەرەکان {
    نەگۆڕ x = ل.ستوون * ٧٠
    ئەگەر ل.کات <= ٧٠ {
      ڕەنگبکە(ڕەنگی(٢٥٥، ٨٠، ٨٠، ٠٫٢ + ٠٫٥ * ل.کات / ٧٠))
      لاکێش(x + ٣٠، ٠، ١٠، ٤٠٠)
      ڕەنگبکە("زەرد")
      سێگۆشە(x + ٣٥، ٢٠، x + ٢٥، ٤٠، x + ٤٥، ٤٠)
    } ئەگەرنا {
      ڕەنگبکە(ڕەنگی(٢٥٥، ٢٠٠، ٢٠٠))
      لاکێش(x + ١٠، ٠، ٥٠، ٤٠٠)
      ڕەنگبکە(ڕەنگی(٢٥٥، ٥٠، ٥٠، ٠٫٦))
      لاکێش(x، ٠، ٧٠، ٤٠٠)
    }
  }
  ڕەنگبکە("ئاسمانی")
  لاکێش(ستوون * ٧٠ + ٢٠، ٣٤٠، ٣٠، ٤٠)
  ڕەنگبکە("سپی")
  بازنە(ستوون * ٧٠ + ٣٥، ٣٥٠، ٦)
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٥، ٢٠)
  نووسین("باشترین: " + بەرزترین، ٢٣٠، ٢٥، ١٦)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٣٥٠، ٤٠٠)
    ڕەنگبکە("سپی")
    نووسین("سووتایت! خاڵ: " + خاڵ، ٩٠، ١٨٠، ٢٨)
    نووسین("کلیک = دووبارە", ١١٠، ٢٢٠، ٢٠)
  }
})
