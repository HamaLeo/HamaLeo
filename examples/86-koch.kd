// ❄ دەنکە بەفری کۆخ — فراکتاڵێک کە لەخۆی پێک دێت: هەر هێڵێک دەکرێتە ٤ هێڵی بچووکتر (Recursion). ئاستەکان لە ٠ بۆ ٤
قەبارە(٤٠٠، ٣٨٠)
پاشبنەمابکە(ڕەنگی(١٥، ٢٠، ٤٥))
هێڵڕەنگبکە(ڕەنگی(١٨٠، ٢٢٠، ٢٥٥))
ئەستووریبکە(١٫٥)

کار کۆخ(x١، y١، x٢، y٢، ئاست) {
  ئەگەر ئاست == ٠ { هێڵ(x١، y١، x٢، y٢)؛ گەڕێنەوە }
  نەگۆڕ dx = (x٢ - x١) / ٣
  نەگۆڕ dy = (y٢ - y١) / ٣
  نەگۆڕ ax = x١ + dx
  نەگۆڕ ay = y١ + dy
  نەگۆڕ bx = x١ + dx * ٢
  نەگۆڕ by = y١ + dy * ٢
  // ددانی سێگۆشەیی لە ناوەڕاست (٦٠ پلە)
  نەگۆڕ px = ax + (dx * ٠٫٥ + dy * ٠٫٨٦٦)
  نەگۆڕ py = ay + (dy * ٠٫٥ - dx * ٠٫٨٦٦)
  کۆخ(x١، y١، ax، ay، ئاست - ١)
  کۆخ(ax، ay، px، py، ئاست - ١)
  کۆخ(px، py، bx، by، ئاست - ١)
  کۆخ(bx، by، x٢، y٢، ئاست - ١)
}

نەگۆڕ ئاست = ٤
نەگۆڕ A = [٥٠، ٢٧٠]
نەگۆڕ B = [٣٥٠، ٢٧٠]
نەگۆڕ C = [٢٠٠، ١٠]
کۆخ(A[٠]، A[١]، C[٠]، C[١]، ئاست)
کۆخ(C[٠]، C[١]، B[٠]، B[١]، ئاست)
کۆخ(B[٠]، B[١]، A[٠]، A[١]، ئاست)
