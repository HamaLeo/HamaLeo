// 🔮 کالیدۆسکۆپ — بە ماوس بکێشە و ٨ جار لە هەموو ئاڕاستەکاندا دووبارە دەبێتەوە! (کلیک = پاککردنەوە)
قەبارە(٤٠٠، ٤٠٠)
گۆڕاو نوختەکان = []
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ١
  گۆڕاو x = ٢٠٠ + سینۆس(کات / ٣٠) * ١٢٠ + سینۆس(کات / ١١) * ٣٠
  گۆڕاو y = ٢٠٠ + کۆسینۆس(کات / ٤٣) * ١٢٠ + کۆسینۆس(کات / ١٧) * ٣٠
  ئەگەر ماوسگیراوە() { x = ماوسX()؛ y = ماوسY() }
  نوختەکان.زیادبکە({ x: x - ٢٠٠، y: y - ٢٠٠، ڕەنگ: کات * ٢ })
  ئەگەر نوختەکان.درێژی > ٢٠٠ { نوختەکان.یەکەمیلابەرە() }
  ئەگەر کلیککراوە() { نوختەکان = [] }
  پاشبنەمابکە(ڕەنگی(١٠، ٥، ٢٥))
  بۆ هەر ن لە نوختەکان {
    ڕەنگبکە(پەلکەزێڕینە(ن.ڕەنگ، ٠٫٧))
    بۆ k لە ٠ تا ٣ {
      نەگۆڕ g = k * پای / ٢
      نەگۆڕ rx = ن.x * کۆسینۆس(g) - ن.y * سینۆس(g)
      نەگۆڕ ry = ن.x * سینۆس(g) + ن.y * کۆسینۆس(g)
      بازنە(٢٠٠ + rx، ٢٠٠ + ry، ٤)
      بازنە(٢٠٠ - rx، ٢٠٠ + ry، ٤)
    }
  }
})
