// یاری: پۆنگی دوو کەس 🏓 — چەپ: W و S — ڕاست: ↑ و ↓. یەکەم کەس بە ٧ خاڵ دەبات. تۆپ هەر لێدانێک خێراتر دەبێت!
قەبارە(٥٠٠، ٣٠٠)
گۆڕاو پادچەپ = ١١٠
گۆڕاو پادڕاست = ١١٠
گۆڕاو x = ٢٥٠
گۆڕاو y = ١٥٠
گۆڕاو dx = ٤
گۆڕاو dy = ٢
گۆڕاو خاڵچەپ = ٠
گۆڕاو خاڵڕاست = ٠
گۆڕاو لێدان = ٠

کار تۆپی_نوێ(ئا) {
  x = ٢٥٠؛ y = ١٥٠؛ لێدان = ٠
  dx = ئا * ٤
  dy = هەڕەمەکی(-٣، ٣)
  ئەگەر dy == ٠ { dy = ٢ }
}

یاریبکە(() => {
  ئەگەر خاڵچەپ < ٧ و خاڵڕاست < ٧ {
    ئەگەر کلیل("w") { پادچەپ -= ٦ }
    ئەگەر کلیل("s") { پادچەپ += ٦ }
    ئەگەر کلیل("سەرەوە") { پادڕاست -= ٦ }
    ئەگەر کلیل("خوارەوە") { پادڕاست += ٦ }
    پادچەپ = سنوور(پادچەپ، ٠، ٢٢٠)؛ پادڕاست = سنوور(پادڕاست، ٠، ٢٢٠)
    x += dx؛ y += dy
    ئەگەر y < ٨ یان y > ٢٩٢ { dy = -dy؛ y = سنوور(y، ٨، ٢٩٢) }
    ئەگەر dx < ٠ و x < ٣٠ و x > ١٦ و y > پادچەپ - ٤ و y < پادچەپ + ٨٤ {
      dx = -dx * ١٫٠٥؛ dy += (y - (پادچەپ + ٤٠)) / ١٠؛ لێدان += ١
    }
    ئەگەر dx > ٠ و x > ٤٧٠ و x < ٤٨٤ و y > پادڕاست - ٤ و y < پادڕاست + ٨٤ {
      dx = -dx * ١٫٠٥؛ dy += (y - (پادڕاست + ٤٠)) / ١٠؛ لێدان += ١
    }
    ئەگەر x < ٠ { خاڵڕاست += ١؛ تۆپی_نوێ(١) }
    ئەگەر x > ٥٠٠ { خاڵچەپ += ١؛ تۆپی_نوێ(-١) }
  } ئەگەرنا ئەگەر کلیککراوە() { خاڵچەپ = ٠؛ خاڵڕاست = ٠؛ تۆپی_نوێ(١) }

  پاشبنەمابکە(ڕەنگی(١٠، ١٥، ٣٠))
  ڕەنگبکە(ڕەنگی(٥٠، ٦٠، ٩٠))
  بۆ i لە ٠ تا ١٤ { لاکێش(٢٤٧، i * ٢٠ + ٤، ٦، ١٢) }
  ڕەنگبکە("ئاسمانی")
  لاکێش(١٤، پادچەپ، ١٠، ٨٠)
  ڕەنگبکە("نارنجی")
  لاکێش(٤٧٦، پادڕاست، ١٠، ٨٠)
  ڕەنگبکە("سپی")
  بازنە(x، y، ٨)
  نووسین(خاڵچەپ، ١٦٠، ٥٠، ٤٠)
  نووسین(خاڵڕاست، ٣٠٠، ٥٠، ٤٠)
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٤))
  نووسین("W / S", ٢٠، ٢٩٠، ١٤)
  نووسین("↑ / ↓", ٤٣٠، ٢٩٠، ١٤)
  ئەگەر خاڵچەپ >= ٧ یان خاڵڕاست >= ٧ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٥٠٠، ٣٠٠)
    ڕەنگبکە("سپی")
    نووسین(خاڵچەپ >= ٧ ? "یاریزانی چەپ بردیەوە! 🎉" : "یاریزانی ڕاست بردیەوە! 🎉", ١١٠، ١٤٠، ٢٦)
    نووسین("کلیک = دووبارە", ٢٠٠، ١٨٠، ٢٠)
  }
})
